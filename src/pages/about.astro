---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.about-hero {
				text-align: center;
				padding: 3rem 0;
			}
			.about-hero h1 {
				font-size: 3rem;
				color: #fff;
			}
			.about-hero p {
				color: rgb(var(--gray-dark));
				font-size: 1.2rem;
				max-width: 600px;
				margin: 1rem auto;
			}
			.timeline {
				position: relative;
				margin: 3rem 0;
			}
			.timeline::before {
				content: '';
				position: absolute;
				left: 20px;
				top: 0;
				bottom: 0;
				width: 2px;
				background: rgba(0, 229, 255, 0.3);
			}
			.timeline-item {
				position: relative;
				padding-left: 3.5rem;
				margin-bottom: 2.5rem;
			}
			.timeline-item::before {
				content: '';
				position: absolute;
				left: 14px;
				top: 8px;
				width: 14px;
				height: 14px;
				border-radius: 50%;
				background: var(--accent);
				box-shadow: 0 0 10px var(--accent);
			.timeline-date {
				color: var(--accent);
				font-family: var(--font-mono);
				font-size: 0.82rem;
				font-weight: 600;
				margin-bottom: 0.4rem;
				display: block;
			}
			.timeline-title {
				font-size: 1.3rem;
				color: #fff;
				margin: 0 0 0.2rem 0;
			}
			.timeline-company {
				color: #94a3b8;
				font-size: 0.95rem;
				margin-bottom: 1rem;
				font-weight: 500;
			}
			.section-title {
				font-size: 2rem;
				color: #fff;
				margin: 4rem 0 2rem 0;
				border-bottom: 1px solid rgba(255,255,255,0.1);
				padding-bottom: 0.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="about-hero">
				<h1>About Me</h1>
				<p>
					Computer Graphics Engineer and Technical Artist blending an engineering background from Politecnico di Torino with low-level rendering architecture, shaders, and procedural pipelines.
				</p>
				<div style="margin-top: 2rem;">
					<a href={`${import.meta.env.BASE_URL}/cv`} class="btn-primary">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
						<span>View / Download CV</span>
					</a>
				</div>
			</section>

			<h2 class="section-title">Work Experience</h2>
			<div class="timeline">
				<div class="timeline-item glass-card">
					<span class="timeline-date">03/2026 - Present</span>
					<h3 class="timeline-title">XR Master Thesis - R&D Graphics Programmer</h3>
					<div class="timeline-company">Lemons in the Room | Firenze</div>
					<p>
						Developing a bio-adaptive HLSL Raymarching framework for Meta Quest 3, rendering dynamic Signed Distance Fields (SDFs) driven by real-time physiological data (BLE). Engineering GPU optimizations including Dynamic Bounding Volumes and Foveated Raymarching to maintain 72Hz+ on standalone hardware.
					</p>
				</div>
				<div class="timeline-item glass-card">
					<span class="timeline-date">01/2025 - 07/2026</span>
					<h3 class="timeline-title">Technical Artist & Project Manager</h3>
					<div class="timeline-company">Level Up Lab (PoliTo Student Team) | Torino</div>
					<p>
						Acted as Technical Producer and Tech Artist for the student gamedev team. Responsible for core gameplay in Unity (C#), shader development in HLSL, and coordinating multidisciplinary teams for 'Line Operator'. 
					</p>
				</div>
				<div class="timeline-item glass-card">
					<span class="timeline-date">10/2024 - 01/2025</span>
					<h3 class="timeline-title">Teaching Assistant (GUI)</h3>
					<div class="timeline-company">Politecnico di Torino | Torino</div>
					<p>
						Provided support to students during lectures and laboratory sessions for the Graphical User Interfaces course. Improved students' comprehension and created high-quality instructional content.
					</p>
				</div>
				<div class="timeline-item glass-card">
					<span class="timeline-date">09/2023 - 06/2024</span>
					<h3 class="timeline-title">Video Artist</h3>
					<div class="timeline-company">RKH SRL | Torino</div>
					<p>
						Operated cameras (RED, Blackmagic 4K/6K, Panasonic S1), assisted DOP with lighting setups, and handled editing/post-production using DaVinci Resolve for music videos, podcasts, and corporate content.
					</p>
				</div>
			</div>

			<h2 class="section-title">Education</h2>
			<div class="timeline">
				<div class="timeline-item glass-card">
					<span class="timeline-date">2024 - 2026 (Expected)</span>
					<h3 class="timeline-title">M.Sc. in Cinema and Media Engineering</h3>
					<div class="timeline-company">Politecnico di Torino</div>
					<p>2nd level degree in Computer Engineering. Expected mark: 106/110.</p>
				</div>
				<div class="timeline-item glass-card">
					<span class="timeline-date">2021 - 2024</span>
					<h3 class="timeline-title">B.Sc. in Cinema and Media Engineering</h3>
					<div class="timeline-company">Politecnico di Torino</div>
					<p>1st level degree in Information Technology. Final mark: 100/110.</p>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
