---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.about-hero {
				text-align: center;
				padding: 3rem 0;
			}
			.about-hero h1 {
				font-size: 3rem;
				color: #fff;
			}
			.about-hero p {
				color: rgb(var(--gray-dark));
				font-size: 1.2rem;
				max-width: 600px;
				margin: 1rem auto;
			}
			.timeline {
				position: relative;
				margin: 3rem 0;
			}
			.timeline::before {
				content: '';
				position: absolute;
				left: 20px;
				top: 0;
				bottom: 0;
				width: 2px;
				background: rgba(0, 229, 255, 0.3);
			}
			.timeline-item {
				position: relative;
				padding-left: 3.5rem;
				margin-bottom: 2.5rem;
			}
			.timeline-item::before {
				content: '';
				position: absolute;
				left: 14px;
				top: 8px;
				width: 14px;
				height: 14px;
				border-radius: 50%;
				background: var(--accent);
				box-shadow: 0 0 10px var(--accent);
			}
			.timeline-date {
				color: var(--accent);
				font-weight: bold;
				margin-bottom: 0.5rem;
				display: block;
			}
			.timeline-title {
				font-size: 1.3rem;
				color: #fff;
				margin: 0 0 0.2rem 0;
			}
			.timeline-company {
				color: rgb(var(--gray-dark));
				font-size: 1rem;
				margin-bottom: 1rem;
				font-weight: 500;
			}
			.section-title {
				font-size: 2rem;
				color: #fff;
				margin: 4rem 0 2rem 0;
				border-bottom: 1px solid rgba(255,255,255,0.1);
				padding-bottom: 0.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="about-hero">
				<h1>About Me</h1>
				<p>
					I am a Game & XR Developer and Multimedia Arts enthusiast, currently pursuing my Master of Science in Cinema and Media Engineering at Politecnico di Torino.
				</p>
			</section>

			<h2 class="section-title">Work Experience</h2>
			<div class="timeline">
				<div class="timeline-item glass-card">
					<span class="timeline-date">03/2026 - Present</span>
					<h3 class="timeline-title">XR Master Thesis - R&D Graphics Programmer</h3>
					<div class="timeline-company">Lemons in the Room | Firenze</div>
					<p>
						Developing a 'context-aware' system for Mixed Reality that makes scanned real-world objects interactive and physically plausible. Implemented a real-time pipeline for Meta Quest 3 capable of converting Depth Maps into continuous geometry through Compute and Mesh Shaders, performing GPU-based topological analysis fused with semantic data to generate procedural PBR materials.
					</p>
				</div>
				<div class="timeline-item glass-card">
					<span class="timeline-date">01/2025 - Present</span>
					<h3 class="timeline-title">Technical Artist & Gameplay Programmer</h3>
					<div class="timeline-company">Level Up Lab | Torino</div>
					<p>
						Responsible for development in Unity, contributing to core gameplay systems design. Managed the creation and integration of 3D models for 'Line Operator' and developed Shaders/Post-Processing effects. 
					</p>
				</div>
				<div class="timeline-item glass-card">
					<span class="timeline-date">10/2024 - 01/2025</span>
					<h3 class="timeline-title">Teaching Assistant (GUI)</h3>
					<div class="timeline-company">Politecnico di Torino | Torino</div>
					<p>
						Provided support to students during lectures and laboratory sessions for the Graphical User Interfaces course. Improved students' comprehension and created high-quality instructional content.
					</p>
				</div>
				<div class="timeline-item glass-card">
					<span class="timeline-date">09/2023 - 06/2024</span>
					<h3 class="timeline-title">Video Artist</h3>
					<div class="timeline-company">RKH SRL | Torino</div>
					<p>
						Operated cameras (RED, Blackmagic 4K/6K, Panasonic S1), assisted DOP with lighting setups, and handled editing/post-production using DaVinci Resolve for music videos, podcasts, and corporate content.
					</p>
				</div>
			</div>

			<h2 class="section-title">Education</h2>
			<div class="timeline">
				<div class="timeline-item glass-card">
					<span class="timeline-date">2024 - 2026 (Expected)</span>
					<h3 class="timeline-title">M.Sc. in Cinema and Media Engineering</h3>
					<div class="timeline-company">Politecnico di Torino</div>
					<p>2nd level degree in Computer Engineering. Expected mark: 106/110.</p>
				</div>
				<div class="timeline-item glass-card">
					<span class="timeline-date">2021 - 2024</span>
					<h3 class="timeline-title">B.Sc. in Cinema and Media Engineering</h3>
					<div class="timeline-company">Politecnico di Torino</div>
					<p>1st level degree in Information Technology. Final mark: 100/110.</p>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
