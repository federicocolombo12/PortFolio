---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('projects')).sort(
	(a, b) => (a.data.rank ?? 99) - (b.data.rank ?? 99),
);

// Get unique categories
const categories = [...new Set(posts.map(post => post.data.category).filter(Boolean))];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1080px;
				max-width: calc(100% - 2.5em);
			}
			.projects-page-header {
				margin-bottom: 2.5rem;
				text-align: center;
			}
			.projects-page-title {
				font-size: 2.8rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				color: #ffffff;
				margin-bottom: 0.5rem;
			}
			.projects-page-subtitle {
				font-size: 1.1rem;
				color: #94a3b8;
				max-width: 650px;
				margin: 0 auto;
			}
			.filter-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				justify-content: center;
				margin-bottom: 3rem;
			}
			.filter-btn {
				background: rgba(13, 19, 32, 0.7);
				border: 1px solid rgba(255, 255, 255, 0.08);
				color: #94a3b8;
				padding: 0.55rem 1.25rem;
				border-radius: 9999px;
				cursor: pointer;
				transition: all 0.25s ease;
				font-size: 0.88rem;
				font-weight: 500;
				font-family: inherit;
				backdrop-filter: blur(10px);
			}
			.filter-btn:hover {
				background: rgba(255, 255, 255, 0.08);
				border-color: rgba(255, 255, 255, 0.25);
				color: #ffffff;
			}
			.filter-btn.active {
				background: var(--accent);
				color: #07090e;
				border-color: var(--accent);
				font-weight: 700;
				box-shadow: 0 0 16px rgba(var(--accent-rgb), 0.35);
			}
			ul {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.project-card {
				background: var(--bg-card);
				border: 1px solid var(--border-subtle);
				border-radius: 16px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
				transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
			}
			.project-card:hover {
				transform: translateY(-5px);
				border-color: var(--border-glow);
				box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 24px rgba(var(--accent-rgb), 0.12);
			}
			.project-card a {
				display: flex;
				flex-direction: column;
				height: 100%;
				text-decoration: none;
				color: inherit;
			}
			.card-thumb-box {
				position: relative;
				width: 100%;
				aspect-ratio: 16/9;
				overflow: hidden;
				background: #000;
			}
			.card-thumb-box img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				box-shadow: none;
				transition: transform 0.4s ease;
				margin: 0;
			}
			.project-card:hover .card-thumb-box img {
				transform: scale(1.04);
			}
			.card-info {
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				flex-grow: 1;
			}
			.category-tag {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--accent);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				margin-bottom: 0.4rem;
				display: block;
				font-weight: 600;
			}
			.title {
				margin: 0 0 0.8rem 0;
				color: #ffffff;
				line-height: 1.3;
				font-size: 1.35rem;
				font-weight: 700;
				transition: color 0.2s ease;
			}
			.project-card:hover .title {
				color: var(--accent);
			}
			.card-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: auto;
			}
			@media (max-width: 800px) {
				ul {
					grid-template-columns: 1fr;
					gap: 1.75rem;
				}
				.projects-page-title {
					font-size: 2.2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="projects-page-header">
				<span class="section-tag">// ARCHIVE & R&D</span>
				<h1 class="projects-page-title">Projects & Technical Works</h1>
				<p class="projects-page-subtitle">Real-time graphics systems, custom rendering engines, procedural tools, and spatial computing.</p>
			</div>

			<section>
				<div class="filter-bar">
					<button class="filter-btn active" data-category="all">All Topics</button>
					{categories.map(category => (
						<button class="filter-btn" data-category={category}>{category}</button>
					))}
				</div>
				
				<ul id="projects-grid">
					{
						posts.map((post) => (
							<li class="project-card" data-category={post.data.category}>
								<a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/projects/${post.id}/`}>
									<div class="card-thumb-box">
										{post.data.heroImage && (
											<Image width={720} height={405} src={post.data.heroImage} alt={post.data.title} />
										)}
									</div>
									<div class="card-info">
										<span class="category-tag">{post.data.category}</span>
										<h4 class="title">{post.data.title}</h4>
										<div class="card-tags">
											{(post.data.tags || []).slice(0, 4).map(tag => (
												<span class="tech-badge">{tag}</span>
											))}
										</div>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />

		<script>
			const filterBtns = document.querySelectorAll('.filter-btn');
			const projectCards = document.querySelectorAll('.project-card');
			
			// Use a Set to track multiple active categories
			let activeCategories = new Set();

			filterBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					const category = btn.getAttribute('data-category');
					
					if (category === 'all') {
						activeCategories.clear();
						filterBtns.forEach(b => b.classList.remove('active'));
						btn.classList.add('active');
					} else {
						// Remove 'all' active state
						document.querySelector('.filter-btn[data-category="all"]').classList.remove('active');
						
						if (activeCategories.has(category)) {
							activeCategories.delete(category);
							btn.classList.remove('active');
						} else {
							activeCategories.add(category);
							btn.classList.add('active');
						}
						
						// If nothing is selected, revert to 'all'
						if (activeCategories.size === 0) {
							document.querySelector('.filter-btn[data-category="all"]').classList.add('active');
						}
					}
					
					// Apply filter
					projectCards.forEach(card => {
						const cardCategory = card.getAttribute('data-category');
						if (activeCategories.size === 0 || activeCategories.has(cardCategory)) {
							card.style.display = 'block';
						} else {
							card.style.display = 'none';
						}
					});
				});
			});
		</script>
	</body>
</html>
