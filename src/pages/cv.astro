---
// No global imports to avoid CSS bleeding
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>Federico Colombo - Resume</title>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<style>
			:root {
				--cv-primary: #0d6b63; /* Teal */
				--cv-dark: #222222;
				--cv-text: #444444;
				--cv-light: #ffffff;
				--cv-bg: #f5f5f5;
			}
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}
			body {
				font-family: 'Montserrat', sans-serif;
				background-color: var(--cv-bg);
				color: var(--cv-text);
				line-height: 1.5;
				-webkit-print-color-adjust: exact;
				print-color-adjust: exact;
			}

			/* Controls for web view */
			.cv-controls {
				text-align: center;
				padding: 20px;
				background-color: #1a1a1a;
				color: white;
				display: flex;
				justify-content: center;
				gap: 20px;
				flex-wrap: wrap;
			}
			.cv-controls button, .cv-controls a {
				background-color: var(--cv-primary);
				color: white;
				border: none;
				padding: 10px 20px;
				font-size: 1rem;
				font-family: 'Montserrat', sans-serif;
				cursor: pointer;
				text-decoration: none;
				border-radius: 5px;
				font-weight: 600;
				transition: opacity 0.2s;
			}
			.cv-controls button:hover, .cv-controls a:hover {
				opacity: 0.8;
			}

			/* A4 Container */
			.cv-container {
				width: 210mm;
				min-height: 297mm;
				background: var(--cv-light);
				margin: 40px auto;
				box-shadow: 0 10px 30px rgba(0,0,0,0.1);
				display: flex;
				overflow: hidden;
				position: relative;
			}
			.cv-container::before {
				content: '';
				position: absolute;
				top: 0;
				bottom: 0;
				left: 0;
				width: 35%;
				background-color: var(--cv-primary);
				z-index: 0;
				-webkit-print-color-adjust: exact;
				print-color-adjust: exact;
			}

			/* Columns */
			.left-column {
				width: 34%;
				background-color: transparent;
				color: var(--cv-light);
				padding: 24px 20px;
				z-index: 1;
			}
			.right-column {
				width: 66%;
				padding: 26px 28px;
				z-index: 1;
			}

			/* Profile Image */
			.profile-pic-container {
				text-align: center;
				margin-bottom: 14px;
			}
			.profile-pic {
				width: 95px;
				height: 95px;
				border-radius: 50%;
				object-fit: cover;
				border: 3px solid var(--cv-light);
				box-shadow: 0 3px 8px rgba(0,0,0,0.2);
			}

			/* Left Column Sections */
			.left-section-title {
				font-size: 0.95rem;
				font-weight: 700;
				margin-bottom: 8px;
				padding-bottom: 4px;
				border-bottom: 1.5px solid rgba(255,255,255,0.4);
				letter-spacing: 0.8px;
				text-transform: uppercase;
				margin-top: 14px;
			}
			
			.left-item {
				margin-bottom: 10px;
			}
			.left-item-title {
				font-size: 0.84rem;
				font-weight: 700;
				margin-bottom: 2px;
				line-height: 1.15;
			}
			.left-item-subtitle {
				font-size: 0.76rem;
				font-weight: 600;
				margin-bottom: 2px;
				opacity: 0.9;
			}
			.left-item-desc {
				font-size: 0.74rem;
				line-height: 1.3;
				opacity: 0.88;
			}

			.skills-list {
				list-style: none;
				font-size: 0.78rem;
				line-height: 1.4;
			}
			.skills-list li {
				margin-bottom: 3px;
			}

			/* Right Column Header */
			.header-name {
				font-size: 2.1rem;
				font-weight: 700;
				color: var(--cv-dark);
				margin-bottom: 2px;
				letter-spacing: -0.5px;
				line-height: 1.1;
			}
			.header-title {
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--cv-primary);
				margin-bottom: 8px;
			}
			.contact-info {
				display: flex;
				flex-wrap: wrap;
				gap: 10px 14px;
				font-size: 0.78rem;
				color: var(--cv-text);
				margin-bottom: 12px;
			}
			.contact-item {
				display: flex;
				align-items: center;
				gap: 4px;
			}
			.contact-icon {
				color: #999;
				font-style: normal;
				font-weight: bold;
			}

			/* Right Column Sections */
			.right-section-title {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--cv-dark);
				margin-bottom: 8px;
				padding-bottom: 3px;
				border-bottom: 1px solid #ccc;
				text-transform: uppercase;
				letter-spacing: 0.8px;
			}
			.profile-text {
				font-size: 0.80rem;
				line-height: 1.38;
				margin-bottom: 12px;
				text-align: justify;
			}

			/* Experience */
			.experience-item {
				margin-bottom: 10px;
			}
			.experience-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 1px;
			}
			.experience-title {
				font-size: 0.88rem;
				font-weight: 700;
				color: var(--cv-dark);
			}
			.experience-date {
				font-size: 0.78rem;
				color: var(--cv-text);
				font-weight: 600;
			}
			.experience-company-location {
				display: flex;
				justify-content: space-between;
				margin-bottom: 3px;
			}
			.experience-company {
				font-size: 0.82rem;
				font-weight: 700;
				color: var(--cv-primary);
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}
			.experience-location {
				font-size: 0.78rem;
				color: var(--cv-text);
			}
			.experience-desc {
				font-size: 0.78rem;
				line-height: 1.35;
				margin-left: 14px;
			}
			.experience-desc li {
				margin-bottom: 2px;
			}

			/* Print Styles */
			@media print {
				@page {
					size: A4 portrait;
					margin: 0;
				}
				html, body {
					width: 210mm;
					height: 297mm;
					max-height: 297mm;
					margin: 0 !important;
					padding: 0 !important;
					overflow: hidden !important;
					background-color: white !important;
				}
				.cv-controls {
					display: none !important;
				}
				.cv-container {
					display: flex !important;
					flex-direction: row !important;
					margin: 0 !important;
					box-shadow: none !important;
					width: 210mm !important;
					height: 297mm !important;
					max-height: 297mm !important;
					min-height: 297mm !important;
					overflow: hidden !important;
					page-break-after: avoid !important;
					page-break-inside: avoid !important;
					break-inside: avoid !important;
				}
				.cv-container::before {
					width: 34% !important;
					-webkit-print-color-adjust: exact;
					print-color-adjust: exact;
				}
				.left-column {
					width: 34% !important;
					padding: 20px 18px !important;
					-webkit-print-color-adjust: exact;
					print-color-adjust: exact;
				}
				.right-column {
					width: 66% !important;
					padding: 22px 24px !important;
				}
				.experience-item, .left-item {
					page-break-inside: avoid !important;
					break-inside: avoid !important;
				}
			}

			@media screen and (max-width: 800px) {
				.cv-container {
					width: 100%;
					flex-direction: column;
					margin: 0;
				}
				.cv-container::before {
					display: none;
				}
				.left-column {
					background-color: var(--cv-primary);
				}
				.left-column, .right-column {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<div class="cv-controls">
			<a href={`${import.meta.env.BASE_URL}/Federico Colombo - Resume.pdf`} download="Federico_Colombo_Resume.pdf">📥 Download PDF</a>
			<a href={`${import.meta.env.BASE_URL}/Federico Colombo - Resume.pdf`} target="_blank" rel="noopener noreferrer">🖨️ Print / View PDF</a>
			<a href={`${import.meta.env.BASE_URL}/cv-ats`}>📄 Classic Format</a>
			<a href={`${import.meta.env.BASE_URL}/cv-it`}>🇮🇹 Versione Italiana</a>
			<a href={`${import.meta.env.BASE_URL}`}>Back to Portfolio</a>
		</div>

		<div class="cv-container">
			<!-- Left Column -->
						<div class="left-column">
				<div class="profile-pic-container">
					<img src={`${import.meta.env.BASE_URL}/profile.jpeg`} alt="Federico Colombo" class="profile-pic" onerror="this.style.display='none'">
