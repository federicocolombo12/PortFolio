---
// No global imports to avoid CSS bleeding
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>Federico Colombo - Resume</title>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<style>
			:root {
				--cv-primary: #0d6b63; /* Teal */
				--cv-dark: #222222;
				--cv-text: #444444;
				--cv-light: #ffffff;
				--cv-bg: #f5f5f5;
			}
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}
			body {
				font-family: 'Montserrat', sans-serif;
				background-color: var(--cv-bg);
				color: var(--cv-text);
				line-height: 1.5;
				-webkit-print-color-adjust: exact;
				print-color-adjust: exact;
			}

			/* Controls for web view */
			.cv-controls {
				text-align: center;
				padding: 20px;
				background-color: #1a1a1a;
				color: white;
				display: flex;
				justify-content: center;
				gap: 20px;
			}
			.cv-controls button, .cv-controls a {
				background-color: var(--cv-primary);
				color: white;
				border: none;
				padding: 10px 20px;
				font-size: 1rem;
				font-family: 'Montserrat', sans-serif;
				cursor: pointer;
				text-decoration: none;
				border-radius: 5px;
				font-weight: 600;
				transition: opacity 0.2s;
			}
			.cv-controls button:hover, .cv-controls a:hover {
				opacity: 0.8;
			}

			/* A4 Container */
			.cv-container {
				width: 210mm;
				min-height: 297mm;
				background: var(--cv-light);
				margin: 40px auto;
				box-shadow: 0 10px 30px rgba(0,0,0,0.1);
				display: flex;
				overflow: hidden;
				position: relative;
			}

			/* Columns */
			.left-column {
				width: 35%;
				background-color: var(--cv-primary);
				color: var(--cv-light);
				padding: 40px 30px;
				z-index: 1;
			}
			.right-column {
				width: 65%;
				padding: 50px 40px;
				z-index: 1;
			}

			/* Profile Image */
			.profile-pic-container {
				text-align: center;
				margin-bottom: 30px;
			}
			.profile-pic {
				width: 140px;
				height: 140px;
				border-radius: 50%;
				object-fit: cover;
				border: 4px solid var(--cv-light);
				box-shadow: 0 4px 10px rgba(0,0,0,0.2);
			}

			/* Left Column Sections */
			.left-section-title {
				font-size: 1.1rem;
				font-weight: 600;
				margin-bottom: 15px;
				padding-bottom: 8px;
				border-bottom: 2px solid rgba(255,255,255,0.5);
				letter-spacing: 1px;
				text-transform: uppercase;
				margin-top: 25px;
			}
			
			.left-item {
				margin-bottom: 20px;
			}
			.left-item-title {
				font-size: 1rem;
				font-weight: 600;
				margin-bottom: 5px;
				line-height: 1.2;
			}
			.left-item-subtitle {
				font-size: 0.85rem;
				font-weight: 500;
				margin-bottom: 5px;
				opacity: 0.9;
			}
			.left-item-desc {
				font-size: 0.85rem;
				line-height: 1.4;
				opacity: 0.85;
			}

			.skills-list {
				list-style: none;
				font-size: 0.9rem;
				line-height: 1.6;
			}
			.skills-list li {
				margin-bottom: 3px;
			}

			/* Right Column Header */
			.header-name {
				font-size: 2.4rem;
				font-weight: 400;
				color: var(--cv-dark);
				margin-bottom: 5px;
				letter-spacing: -1px;
				line-height: 1.1;
			}
			.header-title {
				font-size: 1.1rem;
				font-weight: 500;
				color: var(--cv-primary);
				margin-bottom: 20px;
			}
			.contact-info {
				display: flex;
				flex-wrap: wrap;
				gap: 15px;
				font-size: 0.85rem;
				color: var(--cv-text);
				margin-bottom: 35px;
			}
			.contact-item {
				display: flex;
				align-items: center;
				gap: 5px;
			}
			.contact-icon {
				color: #999;
				font-style: normal;
				font-weight: bold;
			}

			/* Right Column Sections */
			.right-section-title {
				font-size: 1.2rem;
				font-weight: 600;
				color: var(--cv-dark);
				margin-bottom: 15px;
				padding-bottom: 5px;
				border-bottom: 1px solid #ccc;
				text-transform: uppercase;
				letter-spacing: 1px;
			}
			.profile-text {
				font-size: 0.9rem;
				line-height: 1.5;
				margin-bottom: 35px;
				text-align: justify;
			}

			/* Experience */
			.experience-item {
				margin-bottom: 25px;
			}
			.experience-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 2px;
			}
			.experience-title {
				font-size: 1.1rem;
				font-weight: 600;
				color: var(--cv-dark);
			}
			.experience-date {
				font-size: 0.85rem;
				color: var(--cv-text);
				font-weight: 500;
			}
			.experience-company-location {
				display: flex;
				justify-content: space-between;
				margin-bottom: 10px;
			}
			.experience-company {
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--cv-primary);
				text-transform: uppercase;
				letter-spacing: 1px;
			}
			.experience-location {
				font-size: 0.85rem;
				color: var(--cv-text);
			}
			.experience-desc {
				font-size: 0.9rem;
				line-height: 1.5;
				margin-left: 15px;
			}
			.experience-desc li {
				margin-bottom: 4px;
			}

			/* Print Styles */
			@media print {
				body {
					background-color: white;
					margin: 0;
					padding: 0;
				}
				.cv-controls {
					display: none !important;
				}
				.cv-container {
					margin: 0;
					box-shadow: none;
					width: 100%;
					height: 100%;
					min-height: 100vh;
				}
				.left-column {
					-webkit-print-color-adjust: exact;
					print-color-adjust: exact;
				}
				@page {
					size: A4;
					margin: 0;
				}
			}

			@media (max-width: 800px) {
				.cv-container {
					width: 100%;
					flex-direction: column;
					margin: 0;
				}
				.left-column, .right-column {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<div class="cv-controls">
			<a href={`${import.meta.env.BASE_URL}/Federico Colombo - Resume.pdf`} download="Federico_Colombo_Resume.pdf">Download PDF</a>
			<a href={`${import.meta.env.BASE_URL}/cv-it`}>🇮🇹 Versione Italiana</a>
			<a href={`${import.meta.env.BASE_URL}`}>Back to Portfolio</a>
		</div>

		<div class="cv-container">
			<!-- Left Column -->
			<div class="left-column">
				<div class="profile-pic-container">
					<img src={`${import.meta.env.BASE_URL}/profile.jpeg`} alt="Federico Colombo" class="profile-pic" onerror="this.style.display='none'">
				</div>

				<h2 class="left-section-title">Skills</h2>
				<ul class="skills-list">
					<li><strong>Languages:</strong> C#, C++, Python, HLSL/GLSL</li>
					<li><strong>Engines:</strong> Unity, Godot, Unreal Engine</li>
					<li><strong>Software:</strong> Blender, DaVinci Resolve, Jira, Git</li>
					<li><strong>Management:</strong> Agile, Tech Direction, Project Management</li>
				</ul>

				<h2 class="left-section-title">Education</h2>
				<div class="left-item">
					<h3 class="left-item-title">M.Sc. Cinema and Media Engineering</h3>
					<div class="left-item-subtitle">Politecnico di Torino | 2024 - 2026</div>
					<p class="left-item-desc">Expected mark: 106/110.</p>
				</div>
				<div class="left-item">
					<h3 class="left-item-title">B.Sc. Cinema and Media Engineering</h3>
					<div class="left-item-subtitle">Politecnico di Torino | 2021 - 2024</div>
					<p class="left-item-desc">Final mark: 100/110.</p>
				</div>

				<h2 class="left-section-title">Personal Projects</h2>
