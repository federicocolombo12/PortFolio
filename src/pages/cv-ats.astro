---
// No global imports
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>Federico Colombo - ATS Resume</title>
		<style>
			* { box-sizing: border-box; }
			body {
				font-family: 'Times New Roman', Times, serif; /* Standard ATS font */
				font-size: 11pt;
				line-height: 1.5;
				color: #000;
				background-color: #f5f5f5;
				margin: 0;
				padding: 0;
			}
			.controls {
				text-align: center;
				padding: 20px;
				background-color: #1a1a1a;
				color: white;
				display: flex;
				justify-content: center;
				gap: 20px;
			}
			.controls button, .controls a {
				background-color: #0d6b63;
				color: white;
				border: none;
				padding: 10px 20px;
				font-size: 1rem;
				font-family: sans-serif;
				cursor: pointer;
				text-decoration: none;
				border-radius: 5px;
				font-weight: 600;
			}
			.controls button:hover, .controls a:hover { opacity: 0.8; }
			
			.document {
				max-width: 210mm; /* A4 */
				min-height: 297mm;
				margin: 40px auto;
				background-color: #fff;
				padding: 25.4mm; /* 1 inch margin */
				box-shadow: 0 10px 30px rgba(0,0,0,0.1);
			}

			h1 {
				text-align: center;
				font-size: 24pt;
				margin: 0 0 5px 0;
				text-transform: uppercase;
			}
			.subtitle {
				text-align: center;
				font-size: 12pt;
				font-weight: bold;
				margin-bottom: 5px;
			}
			.contact {
				text-align: center;
				font-size: 10pt;
				margin-bottom: 20px;
			}
			h2 {
				font-size: 12pt;
				border-bottom: 1px solid #000;
				text-transform: uppercase;
				margin-top: 15px;
				margin-bottom: 10px;
				padding-bottom: 2px;
			}
			.job-header {
				display: flex;
				justify-content: space-between;
				font-weight: bold;
			}
			.job-subtitle {
				display: flex;
				justify-content: space-between;
				font-style: italic;
				margin-bottom: 5px;
			}
			ul {
				margin-top: 5px;
				padding-left: 20px;
				margin-bottom: 15px;
			}
			li {
				margin-bottom: 3px;
			}
			p { margin-bottom: 15px; }

			@media print {
				body { background-color: #fff; }
				.controls { display: none !important; }
				.document {
					margin: 0;
					padding: 0;
					box-shadow: none;
					width: 100%;
					max-width: 100%;
				}
				@page { margin: 1in; size: A4; }
			}
		</style>
	</head>
	<body>
		<div class="controls">
			<a href={`${import.meta.env.BASE_URL}/Federico Colombo - ATS Resume_Eng.pdf`} download="Federico_Colombo_ATS_Resume.pdf">Download PDF</a>
