						<div class="cv-buttons-grid">
							<a href={`${baseUrl}/Federico Colombo - Resume.pdf`} download class="btn-primary" style="font-size: 0.85rem; padding: 0.6rem 0.85rem;">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
								<span>Graphic CV (EN)</span>
							</a>
							<a href={`${baseUrl}/Federico Colombo - Curriculum Vitae.pdf`} download class="btn-secondary" style="font-size: 0.85rem; padding: 0.6rem 0.85rem;">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
