---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 4rem 0;
				text-align: left;
			}
			.hero h1 {
				font-size: 3.5rem;
				margin-bottom: 0.5rem;
				background: -webkit-linear-gradient(45deg, var(--accent), #fff);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.hero h2 {
				font-size: 1.5rem;
				color: var(--accent);
				margin-bottom: 2rem;
				font-weight: 500;
			}
			.bio {
				font-size: 1.1rem;
				line-height: 1.8;
				margin-bottom: 3rem;
				color: rgb(var(--gray-dark));
			}
			.skills-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 1.5rem;
				margin-top: 2rem;
			}
			.skill-category h3 {
				font-size: 1.2rem;
				margin-bottom: 1rem;
				color: #fff;
			}
			.skill-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.skill-tag {
				background: rgba(0, 229, 255, 0.1);
				border: 1px solid rgba(0, 229, 255, 0.2);
				color: var(--accent);
				padding: 0.3rem 0.8rem;
				border-radius: 20px;
				font-size: 0.9rem;
				font-weight: 500;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Federico Colombo</h1>
				<h2>Game and XR Developer</h2>
				<p class="bio">
					Passionate about crafting immersive interactive experiences. With a strong foundation in <strong>3D</strong> and <strong>programming</strong>, I specialize in creating engaging gameplay mechanics and user experiences. Currently pursuing a Master's in Cinema and Media Engineering at Politecnico di Torino, I'm based in Italy and actively developing both 2D and 3D games while exploring emerging technologies in game development.<br/><br/>
					My focus areas include <strong>Unity</strong> and <strong>Godot</strong> development, procedural generation, and player-centric design approaches.
				</p>
			</section>

			<section class="skills">
				<h2>Technical Skills</h2>
				<div class="skills-grid">
					<div class="glass-card skill-category">
						<h3>Languages</h3>
						<div class="skill-tags">
							<span class="skill-tag">C#</span>
							<span class="skill-tag">C++</span>
							<span class="skill-tag">Python</span>
							<span class="skill-tag">HLSL/GLSL</span>
						</div>
					</div>
					<div class="glass-card skill-category">
						<h3>Engines</h3>
						<div class="skill-tags">
							<span class="skill-tag">Unity</span>
							<span class="skill-tag">Godot</span>
							<span class="skill-tag">Unreal Engine</span>
						</div>
					</div>
					<div class="glass-card skill-category">
						<h3>Software</h3>
						<div class="skill-tags">
							<span class="skill-tag">Blender</span>
							<span class="skill-tag">DaVinci Resolve</span>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
