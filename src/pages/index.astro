		<!-- Interactive Client Script -->
		<script>
			// Parse media map
			const mediaDataEl = document.getElementById('projectMediaData');
			const projectMediaMap = mediaDataEl ? JSON.parse(mediaDataEl.textContent || '{}') : {};

			// Custom gradual smooth scroll with easeInOutCubic (slower for premium tactile UX)
			function smoothScrollTo(targetY: number, duration = 1000) {
				const startY = window.pageYOffset;
				const distance = targetY - startY;
				if (Math.abs(distance) < 2) return;
				const startTime = performance.now();

				function easeInOutCubic(t: number) {
					return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
				}

				function step(currentTime: number) {
					const elapsed = currentTime - startTime;
					const progress = Math.min(elapsed / duration, 1);
					const ease = easeInOutCubic(progress);
					window.scrollTo(0, startY + distance * ease);

					if (progress < 1) {
						requestAnimationFrame(step);
					}
				}

				requestAnimationFrame(step);
			}

			// 1. Smooth Navigation Anchors
			document.querySelectorAll('a[href*="#"]').forEach((anchor) => {
				const href = anchor.getAttribute('href');
				if (!href || href === '#' || (href.startsWith('http') && !href.includes(window.location.hostname))) return;
				const hash = href.includes('#') ? href.split('#')[1] : '';
				if (!hash) return;
				const target = document.getElementById(hash);
				if (target) {
					anchor.addEventListener('click', (e) => {
						e.preventDefault();
						const headerOffset = 70;
						const elementPosition = target.getBoundingClientRect().top;
						const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

						smoothScrollTo(offsetPosition, 1000);
						try {
							history.pushState(null, '', '#' + hash);
						} catch (err) {}
					});
				}
			});

			// Back to Top Button
			const backToTopBtn = document.getElementById('backToTopBtn');
			window.addEventListener('scroll', () => {
				if (window.scrollY > 400) {
					backToTopBtn?.classList.add('visible');
				} else {
					backToTopBtn?.classList.remove('visible');
				}
			});
			backToTopBtn?.addEventListener('click', () => {
				smoothScrollTo(0, 1000);
			});

			// 2. Hero Showreel Slideshow
			const slides = document.querySelectorAll('.showreel-slide-media');
			const dots = document.querySelectorAll('.showreel-dot');
			const showreelTitle = document.getElementById('showreelTitle');
			const showreelSub = document.getElementById('showreelSub');
			const showreelScreen = document.getElementById('showreelScreen');
			let currentSlide = 0;
			let slideInterval: any = null;

			function goToSlide(index: number) {
				slides.forEach((s) => s.classList.remove('active'));
				dots.forEach((d) => d.classList.remove('active'));

				currentSlide = (index + slides.length) % slides.length;
				const activeSlide = slides[currentSlide] as HTMLElement;
				activeSlide.classList.add('active');
				dots[currentSlide]?.classList.add('active');

				if (showreelTitle) showreelTitle.textContent = activeSlide.getAttribute('data-title') || '';
				if (showreelSub) showreelSub.textContent = activeSlide.getAttribute('data-sub') || '';

				// If slide has video, trigger play
				const vid = activeSlide.querySelector('video') as HTMLVideoElement;
				if (vid) {
					vid.currentTime = 0;
					vid.play().catch(() => {});
				}
			}

			function startSlideshow() {
				slideInterval = setInterval(() => {
					goToSlide(currentSlide + 1);
				}, 4800);
			}

			function stopSlideshow() {
				if (slideInterval) clearInterval(slideInterval);
			}

			dots.forEach((dot) => {
				dot.addEventListener('click', (e) => {
					e.stopPropagation();
					const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
					goToSlide(idx);
				});
			});

			showreelScreen?.addEventListener('mouseenter', stopSlideshow);
			showreelScreen?.addEventListener('mouseleave', startSlideshow);
			showreelScreen?.addEventListener('click', () => {
				const activeSlide = slides[currentSlide] as HTMLElement;
				const projectId = activeSlide.getAttribute('data-project-id');
				if (projectId) {
					const card = document.querySelector(`.project-card[data-id="${projectId}"]`) as HTMLElement;
					if (card) openModal(card);
				}
			});

			startSlideshow();

			// 3. Expand Chevron Arrow (Image 1 match)
			const expandChevronBtn = document.getElementById('expandChevronBtn');
			let isExpanded = false;

			expandChevronBtn?.addEventListener('click', () => {
				isExpanded = !isExpanded;
				const hiddenCards = document.querySelectorAll('.project-card.hidden-card');
				if (isExpanded) {
					hiddenCards.forEach((c, idx) => {
						const cardEl = c as HTMLElement;
						cardEl.style.display = 'flex';
						setTimeout(() => {
							cardEl.classList.add('revealed');
						}, 35 * idx + 20);
					});
				} else {
					hiddenCards.forEach((c) => {
						const cardEl = c as HTMLElement;
						cardEl.classList.remove('revealed');
						setTimeout(() => {
							if (!isExpanded) cardEl.style.display = 'none';
						}, 450);
					});
				}
				expandChevronBtn.classList.toggle('expanded', isExpanded);
			});

			// Category Filter Handler
			const filterButtons = document.querySelectorAll('.filter-btn');
			const projectCards = document.querySelectorAll('.project-card');

			filterButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					filterButtons.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');

					const cat = btn.getAttribute('data-category');
					let count = 0;
					projectCards.forEach((c) => {
						const cardEl = c as HTMLElement;
						const cardCat = cardEl.getAttribute('data-category');
						const matches = cat === 'all' || cardCat === cat;

						if (matches) {
							// If filtered, show cards matching filter
							if (cat === 'all') {
								if (isExpanded || count < 3) {
									cardEl.style.display = 'flex';
									if (isExpanded) cardEl.classList.add('revealed');
								} else {
									cardEl.style.display = 'none';
									cardEl.classList.remove('revealed');
								}
							} else {
								cardEl.style.display = 'flex';
								cardEl.classList.add('revealed');
							}
							count++;
						} else {
							cardEl.style.display = 'none';
						}
					});

					// Hide chevron button if viewing specific category
					if (expandChevronBtn) {
						expandChevronBtn.style.display = cat === 'all' ? 'flex' : 'none';
					}
				});
			});

			// 4. In-Page Project Modal with Gallery Carousel (Image 2 match)
			const modal = document.getElementById('projectModal');
			const modalCloseBtn = document.getElementById('modalCloseBtn');
			const modalVideo = document.getElementById('modalVideo') as HTMLVideoElement;
			const modalImage = document.getElementById('modalImage') as HTMLImageElement;
			const modalArrowLeft = document.getElementById('modalArrowLeft');
			const modalArrowRight = document.getElementById('modalArrowRight');
			const modalThumbStrip = document.getElementById('modalThumbStrip');
			const modalCategory = document.getElementById('modalCategory');
			const modalTitle = document.getElementById('modalTitle');
			const modalTags = document.getElementById('modalTags');
			const modalActions = document.getElementById('modalActions');
			const modalArticleBody = document.getElementById('modalArticleBody');

			let currentMediaItems: Array<{ type: 'video' | 'image', url: string, thumb: string, title?: string }> = [];
			let activeMediaIdx = 0;

			function renderMediaItem(index: number) {
				if (!currentMediaItems.length) return;
				activeMediaIdx = (index + currentMediaItems.length) % currentMediaItems.length;
				const item = currentMediaItems[activeMediaIdx];

				// Update Thumbnails
				document.querySelectorAll('.modal-thumb-item').forEach((th, i) => {
					th.classList.toggle('active', i === activeMediaIdx);
				});

				if (item.type === 'video') {
					if (modalImage) modalImage.style.display = 'none';
					if (modalVideo) {
						modalVideo.src = item.url;
						modalVideo.style.display = 'block';
						modalVideo.play().catch(() => {});
					}
				} else {
					if (modalVideo) {
						modalVideo.pause();
						modalVideo.style.display = 'none';
					}
					if (modalImage) {
						modalImage.src = item.url;
						modalImage.style.display = 'block';
					}
				}
			}

			function closeModal() {
				if (!modal) return;
				modal.classList.remove('open');
				modal.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
				if (modalVideo) {
					modalVideo.pause();
					modalVideo.src = '';
					modalVideo.style.display = 'none';
				}
				if (modalImage) {
					modalImage.src = '';
					modalImage.style.display = 'none';
				}
			}

			function openModal(card: HTMLElement) {
				if (!modal) return;
				const id = card.getAttribute('data-id') || '';
				const title = card.getAttribute('data-title') || '';
				const category = card.getAttribute('data-category') || '';
				const defaultImg = card.getAttribute('data-image') || '';
				const tags = (card.getAttribute('data-tags') || '').split(',').filter(Boolean);
				const github = card.getAttribute('data-github') || '';
				const itch = card.getAttribute('data-itch') || '';
				const raicinema = card.getAttribute('data-raicinema') || '';
				const youtube = card.getAttribute('data-youtube') || '';

				if (modalTitle) modalTitle.textContent = title;
				if (modalCategory) modalCategory.textContent = category;

				// Setup Media Gallery
				const explicitMedia = projectMediaMap[id] || [];
				if (explicitMedia.length > 0) {
					currentMediaItems = explicitMedia;
				} else if (defaultImg) {
					currentMediaItems = [{ type: 'image', url: defaultImg, thumb: defaultImg }];
				} else {
					currentMediaItems = [];
				}

				// Build Thumbnail Strip
				if (modalThumbStrip) {
					modalThumbStrip.innerHTML = '';
					if (currentMediaItems.length > 1) {
						modalThumbStrip.style.display = 'flex';
						if (modalArrowLeft) modalArrowLeft.style.display = 'flex';
						if (modalArrowRight) modalArrowRight.style.display = 'flex';

						currentMediaItems.forEach((media, idx) => {
							const thumbBtn = document.createElement('div');
							thumbBtn.className = `modal-thumb-item ${idx === 0 ? 'active' : ''}`;
							thumbBtn.innerHTML = `
								<img src="${media.thumb}" alt="Thumbnail ${idx + 1}" />
								${media.type === 'video' ? '<span class="thumb-video-icon"><svg width="10" height="10" viewBox="0 0 24 24" fill="#fff"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg></span>' : ''}
							`;
							thumbBtn.addEventListener('click', () => renderMediaItem(idx));
							modalThumbStrip.appendChild(thumbBtn);
						});
					} else {
						modalThumbStrip.style.display = 'none';
						if (modalArrowLeft) modalArrowLeft.style.display = 'none';
						if (modalArrowRight) modalArrowRight.style.display = 'none';
					}
				}

				renderMediaItem(0);

				// Tags Handling
				if (modalTags) {
					modalTags.innerHTML = '';
					tags.forEach((tag) => {
						const span = document.createElement('span');
						span.className = 'tech-badge';
						span.textContent = tag.trim();
						modalTags.appendChild(span);
					});
				}

				// Actions Handling
				if (modalActions) {
					modalActions.innerHTML = '';

					if (github) {
						const btn = document.createElement('a');
						btn.href = github;
						btn.target = '_blank';
						btn.className = 'btn-secondary';
						btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg><span>GitHub Source</span>`;
						modalActions.appendChild(btn);
					}

					if (itch) {
						const btn = document.createElement('a');
						btn.href = itch;
						btn.target = '_blank';
						btn.className = 'btn-secondary';
						btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg><span>Play on Itch.io</span>`;
						modalActions.appendChild(btn);
					}

					if (raicinema) {
						const btn = document.createElement('a');
						btn.href = raicinema;
						btn.target = '_blank';
						btn.className = 'btn-secondary';
						btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path></svg><span>Rai Cinema Channel</span>`;
						modalActions.appendChild(btn);
					}

					if (youtube) {
						const btn = document.createElement('a');
						btn.href = youtube;
						btn.target = '_blank';
						btn.className = 'btn-secondary';
						btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg><span>Watch Video</span>`;
						modalActions.appendChild(btn);
					}
				}

				// Inject Full Technical Deep Dive Article directly in the modal!
				if (modalArticleBody) {
					const storedArticle = document.getElementById(`article-content-${id}`);
					if (storedArticle) {
						modalArticleBody.innerHTML = storedArticle.innerHTML;
					} else {
						modalArticleBody.innerHTML = `<p>${card.getAttribute('data-desc') || ''}</p>`;
					}
				}

				modal.classList.add('open');
				modal.setAttribute('aria-hidden', 'false');
				document.body.style.overflow = 'hidden';
			}

			// Modal Arrow Clicks
			modalArrowLeft?.addEventListener('click', (e) => {
				e.stopPropagation();
				renderMediaItem(activeMediaIdx - 1);
			});
			modalArrowRight?.addEventListener('click', (e) => {
				e.stopPropagation();
				renderMediaItem(activeMediaIdx + 1);
			});

			// Attach project card clicks
			document.querySelectorAll('.project-card').forEach((card) => {
				card.addEventListener('click', () => {
					openModal(card as HTMLElement);
				});
			});

			modalCloseBtn?.addEventListener('click', closeModal);

			modal?.addEventListener('click', (e) => {
				if (e.target === modal) {
					closeModal();
				}
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && modal?.classList.contains('open')) {
					closeModal();
				}
				if (modal?.classList.contains('open')) {
					if (e.key === 'ArrowLeft') renderMediaItem(activeMediaIdx - 1);
					if (e.key === 'ArrowRight') renderMediaItem(activeMediaIdx + 1);
				}
			});

			// 5. Experience vs Education Toggle Handler
			const tabExpBtn = document.getElementById('tabExpBtn');
			const tabEduBtn = document.getElementById('tabEduBtn');
			const expList = document.getElementById('expList');
			const eduList = document.getElementById('eduList');

			if (tabExpBtn && tabEduBtn && expList && eduList) {
				tabExpBtn.addEventListener('click', () => {
					tabExpBtn.classList.add('active');
					tabEduBtn.classList.remove('active');
					expList.style.display = 'flex';
					eduList.style.display = 'none';
				});

				tabEduBtn.addEventListener('click', () => {
					tabEduBtn.classList.add('active');
					tabExpBtn.classList.remove('active');
					eduList.style.display = 'flex';
					expList.style.display = 'none';
				});
			}
		</script>
	</body>
</html>
