---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 4rem 0;
				text-align: left;
			}
			.hero h1 {
				font-size: 3.5rem;
				margin-bottom: 0.5rem;
				background: -webkit-linear-gradient(45deg, var(--accent), #fff);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.hero h2 {
				font-size: 1.5rem;
				color: var(--accent);
				margin-bottom: 2rem;
				font-weight: 500;
			}
			.bio {
				font-size: 1.1rem;
				line-height: 1.8;
				margin-bottom: 3rem;
				color: rgb(var(--gray-dark));
			}
			.skills-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 1.5rem;
				margin-top: 2rem;
			}
			.skill-category h3 {
				font-size: 1.2rem;
				margin-bottom: 1rem;
				color: #fff;
			}
			.skill-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.skill-tag {
				background: rgba(0, 229, 255, 0.1);
				border: 1px solid rgba(0, 229, 255, 0.2);
				color: var(--accent);
				padding: 0.3rem 0.8rem;
				border-radius: 20px;
				font-size: 0.9rem;
				font-weight: 500;
			}
			.hero-header {
				position: relative;
				margin-top: 1rem;
				margin-bottom: 4rem;
			}
			.hero-banner {
				width: 100%;
				height: 200px;
				border-radius: 12px;
				overflow: hidden;
				background: linear-gradient(90deg, var(--accent), #1f2937);
			}
			.hero-banner img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.hero-profile-pic {
				position: absolute;
				bottom: -60px;
				left: 2rem;
				width: 140px;
				height: 140px;
				border-radius: 50%;
				border: 6px solid #0a0f14;
				background: #1f2937;
				overflow: hidden;
			}
			.hero-profile-pic img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero-header">
				<div class="hero-banner">
					<img src={`${import.meta.env.BASE_URL}/banner.jpeg`} alt="Background Banner" onerror="this.style.display='none'" />
				</div>
				<div class="hero-profile-pic">
					<img src={`${import.meta.env.BASE_URL}/profile.jpeg`} alt="Federico Colombo" />
				</div>
			</div>
			<section class="hero">
				<h1>Federico Colombo</h1>
				<h2>Computer Graphics Engineer</h2>
				<p class="bio">
					<strong>Computer Graphics Engineer</strong> passionate about building <strong>real-time graphics systems</strong>, interactive simulations, and <strong>developer tools</strong>.<br/><br/>
					I am currently completing my Master's Degree in Cinema and Media Engineering at Politecnico di Torino, where I am developing a real-time <strong>Signed Distance Field (SDF) editor</strong> for medical applications. My work combines computer graphics, geometry processing, <strong>software engineering</strong>, and interactive visualization to create tools that solve real-world problems.<br/><br/>
					My background spans game development, XR, and interactive media, but my interests have naturally evolved toward <strong>graphics programming</strong>, rendering, simulation, and technical tool development. I enjoy understanding how systems work internally, implementing graphics techniques from first principles, and transforming research ideas into practical software.<br/><br/>
					Throughout my projects, I have often acted as the <strong>bridge between disciplines</strong>, collaborating with programmers, artists, and designers while remaining deeply involved in implementation. I enjoy designing technical pipelines, developing robust <strong>software architectures</strong>, and creating tools that improve the workflow of multidisciplinary teams.<br/><br/>
					I am currently expanding my expertise in <strong>modern rendering, GPU programming</strong>, geometry processing, and <strong>AI-assisted graphics</strong> through personal research projects, with the long-term goal of contributing to research and development in computer graphics and interactive technologies.
				</p>
			</section>

			<section class="skills">
				<h2>Technical Skills</h2>
				<div class="skills-grid">
					<div class="glass-card skill-category">
						<h3>Languages</h3>
						<div class="skill-tags">
							<span class="skill-tag">C#</span>
							<span class="skill-tag">C++</span>
							<span class="skill-tag">Python</span>
							<span class="skill-tag">HLSL/GLSL</span>
						</div>
					</div>
					<div class="glass-card skill-category">
						<h3>Engines</h3>
						<div class="skill-tags">
							<span class="skill-tag">Unity</span>
							<span class="skill-tag">Godot</span>
							<span class="skill-tag">Unreal Engine</span>
						</div>
					</div>
					<div class="glass-card skill-category">
						<h3>Software & Tools</h3>
						<div class="skill-tags">
							<span class="skill-tag">Blender</span>
							<span class="skill-tag">DaVinci Resolve</span>
							<span class="skill-tag">Jira</span>
							<span class="skill-tag">Git</span>
						</div>
					</div>
					<div class="glass-card skill-category">
						<h3>Management & Roles</h3>
						<div class="skill-tags">
							<span class="skill-tag">Project Management</span>
							<span class="skill-tag">Tech Direction</span>
							<span class="skill-tag">Tech Art</span>
							<span class="skill-tag">Agile</span>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
