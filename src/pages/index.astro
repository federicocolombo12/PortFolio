			.work-card:hover {
				border-color: var(--border-strong);
				transform: translateY(-2px);
			}

			.card-thumb {
				position: relative;
				aspect-ratio: 16 / 9;
				background: #0d0e11;
				border-bottom: 1px solid var(--border);
				overflow: hidden;
			}

			.card-thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.28s ease;
			}

			.work-card:hover .card-thumb img {
				transform: scale(1.025);
			}

			.card-idx {
				position: absolute;
				top: 10px;
				left: 10px;
				padding: 2px 7px;
				border-radius: 2px;
				background: rgba(19, 20, 22, 0.85);
				border: 1px solid rgba(255, 255, 255, 0.14);
				font-family: var(--font-mono);
				font-size: 10.5px;
				color: #eceae4;
			}

			.card-gh-corner {
				position: absolute;
				top: 10px;
				right: 10px;
				width: 26px;
				height: 26px;
				border-radius: 50%;
				background: rgba(19, 20, 22, 0.86);
				border: 1px solid rgba(255, 255, 255, 0.18);
				color: #eceae4;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: border-color 0.12s ease, color 0.12s ease;
			}

			.card-gh-corner:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			.card-body {
				flex: 1;
				display: flex;
				flex-direction: column;
				padding: 16px 18px;
			}

			.card-cat {
				font-family: var(--font-mono);
				font-size: 10.5px;
				letter-spacing: 0.05em;
				color: var(--accent);
				margin-bottom: 4px;
			}

			.card-title {
				margin: 0 0 8px;
				font-family: 'Instrument Serif', Georgia, serif;
				font-weight: 400;
				font-size: 21px;
				line-height: 1.15;
				color: var(--ink);
			}

			.card-desc {
				margin: 0 0 14px;
				font-size: 13px;
				line-height: 1.5;
				color: var(--ink-2);
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.card-foot {
				margin-top: auto;
				padding-top: 10px;
				border-top: 1px solid var(--border);
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 10px;
				font-family: var(--font-mono);
				font-size: 10.5px;
				color: var(--muted);
			}

			.card-demo-pill {
				color: var(--accent);
				flex-shrink: 0;
			}

			.expand-row {
				margin-top: 28px;
				display: flex;
				justify-content: center;
			}

			.expand-btn {
				padding: 9px 18px;
				border: 1px solid var(--border-strong);
				border-radius: var(--radius);
				font-family: var(--font-mono);
				font-size: 12px;
				color: var(--ink);
				transition: border-color 0.12s ease, color 0.12s ease;
			}

			.expand-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* =========================================================
			   4, 5, 6. BACKGROUND, ABOUT, CONTACT
			   ========================================================= */
			.experience-band,
			.about-band,
			.contact-band {
				padding: 36px 0 48px;
			}

			.band-top-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 12px;
				padding-bottom: 12px;
				margin-bottom: 24px;
				border-bottom: 1px solid var(--border);
			}

			.band-mono-label {
				font-family: var(--font-mono);
				font-size: 11px;
				letter-spacing: 0.06em;
				color: var(--muted);
			}

			.tab-switch-inline {
				display: inline-flex;
				gap: 6px;
			}

			.tab-btn {
				padding: 4px 10px;
				border: 1px solid var(--border);
				border-radius: 2px;
				font-family: var(--font-mono);
				font-size: 11.5px;
				color: var(--ink-2);
			}

			.tab-btn.active {
				border-color: var(--accent);
				background: var(--accent-soft);
				color: var(--accent);
			}

			.timeline-rows {
				display: flex;
				flex-direction: column;
			}

			.timeline-row {
				display: grid;
				grid-template-columns: 260px minmax(0, 1fr);
				gap: 28px;
				padding: 18px 0;
				border-bottom: 1px solid var(--border);
			}

			.tl-left {
				display: flex;
				flex-direction: column;
				gap: 4px;
			}

			.tl-date {
				font-family: var(--font-mono);
				font-size: 12px;
				color: var(--accent);
			}

			.tl-org {
				font-size: 13px;
				color: var(--muted);
			}

			.tl-role {
				margin: 0 0 6px;
				font-size: 16px;
				font-weight: 600;
				color: var(--ink);
			}

			.tl-bullets {
				margin: 0;
				padding-left: 18px;
				color: var(--ink-2);
				font-size: 14px;
			}

			.tl-bullets li + li {
				margin-top: 4px;
			}

			.about-split {
				display: grid;
				grid-template-columns: 180px minmax(0, 1fr);
				gap: 30px;
				margin-bottom: 28px;
				align-items: start;
			}

			.portrait-box {
				border: 1px solid var(--border);
				border-radius: var(--radius);
				overflow: hidden;
			}

			.portrait-box img {
				width: 100%;
				aspect-ratio: 1 / 1;
				object-fit: cover;
				filter: grayscale(18%);
			}

			.bio-copy h2 {
				margin-bottom: 12px;
			}

			.bio-copy p {
				margin: 0 0 10px;
				max-width: 66ch;
				color: var(--ink-2);
			}

			.skills-cols {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 20px;
			}

			.skill-col {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 16px 18px;
			}

			.skill-col-title {
				margin: 0 0 10px;
				font-family: var(--font-mono);
				font-size: 11.5px;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: var(--accent);
			}

			.skill-col ul {
				margin: 0;
				padding: 0;
				list-style: none;
				font-size: 13.5px;
				color: var(--ink-2);
			}

			.skill-col li {
				padding: 5px 0;
				border-bottom: 1px solid var(--border);
			}

			.skill-col li:last-child {
				border-bottom: none;
				padding-bottom: 0;
			}

			.contact-grid {
				display: grid;
				grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.85fr);
				gap: 32px;
			}

			.contact-note {
				margin: 10px 0 16px;
				color: var(--ink-2);
				max-width: 56ch;
			}

			.contact-links {
				display: flex;
				flex-wrap: wrap;
				gap: 10px 22px;
				font-family: var(--font-mono);
				font-size: 12px;
			}

			.contact-links a {
				border-bottom: 1px solid var(--border-strong);
				padding-bottom: 2px;
			}

			.contact-links a:hover {
				color: var(--accent);
				border-color: var(--accent);
			}

			.cv-card {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 18px;
			}

			.cv-btn-stack {
				margin-top: 12px;
				display: flex;
				flex-direction: column;
				gap: 8px;
			}

			.btn-solid-full,
			.btn-outline-full,
			.btn-solid-inline,
			.btn-outline-inline {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 9px 15px;
				border-radius: 2px;
				font-size: 13px;
				font-weight: 500;
			}

			.btn-solid-full,
			.btn-solid-inline {
				background: var(--accent);
				color: var(--accent-ink);
				border: 1px solid var(--accent);
			}

			.btn-outline-full,
			.btn-outline-inline {
				border: 1px solid var(--border-strong);
				color: var(--ink);
			}

			.btn-solid-full,
			.btn-outline-full {
				width: 100%;
			}

			.site-footer {
				border-top: 1px solid var(--border);
				padding: 20px 0;
				font-family: var(--font-mono);
				font-size: 11px;
				color: var(--muted);
			}

			.footer-inner {
				display: flex;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 10px;
			}

			.back-to-top-btn {
				position: fixed;
				right: 22px;
				bottom: 22px;
				z-index: 35;
				width: 36px;
				height: 36px;
				border-radius: 2px;
				border: 1px solid var(--border-strong);
				background: var(--surface);
				color: var(--ink);
				font-family: var(--font-mono);
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.18s ease, border-color 0.15s ease;
			}

			.back-to-top-btn.visible {
				opacity: 1;
				pointer-events: auto;
			}

			.back-to-top-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* =========================================================
			   MODAL
			   ========================================================= */
			.modal-overlay {
				position: fixed;
				inset: 0;
				z-index: 100;
				background: rgba(12, 13, 15, 0.8);
				display: none;
				align-items: center;
				justify-content: center;
				padding: 20px;
			}

			.modal-overlay.open {
				display: flex;
			}

			.modal-box {
				position: relative;
				width: 100%;
				max-width: 940px;
				max-height: 90vh;
				overflow-y: auto;
				background: var(--bg);
				border: 1px solid var(--border-strong);
				border-radius: var(--radius);
				color: var(--ink);
			}

			.modal-close-btn {
				position: sticky;
				top: 12px;
				float: right;
				margin: 12px 12px 0 0;
				z-index: 10;
				width: 32px;
				height: 32px;
				border: 1px solid var(--border-strong);
				background: var(--bg);
				color: var(--ink);
				font-size: 20px;
				line-height: 1;
			}

			.modal-viewer {
				background: #060708;
				border-bottom: 1px solid var(--border);
			}

			.modal-stage {
				position: relative;
				aspect-ratio: 16 / 9;
				max-height: 52vh;
				margin: 0 auto;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.modal-stage video,
			.modal-stage img {
				max-width: 100%;
				max-height: 52vh;
				object-fit: contain;
			}

			.stage-arrow {
				position: absolute;
				top: 50%;
				transform: translateY(-50%);
				z-index: 4;
				width: 36px;
				height: 36px;
				border-radius: 50%;
				background: rgba(19, 20, 22, 0.8);
				border: 1px solid rgba(255, 255, 255, 0.2);
				color: #fff;
				font-size: 20px;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.stage-arrow.arrow-left {
				left: 12px;
			}

			.stage-arrow.arrow-right {
				right: 12px;
			}

			.modal-thumbs {
				display: flex;
				gap: 8px;
				padding: 10px 14px;
				overflow-x: auto;
				background: var(--surface);
				border-top: 1px solid var(--border);
			}

			.modal-thumb-item {
				width: 80px;
				height: 46px;
				flex-shrink: 0;
				padding: 0;
				border: 2px solid transparent;
				opacity: 0.65;
			}

			.modal-thumb-item.active {
				border-color: var(--accent);
				opacity: 1;
			}

			.modal-thumb-item img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.modal-content {
				padding: 24px 28px 32px;
			}

			.modal-kicker {
				font-family: var(--font-mono);
				font-size: 11px;
				color: var(--accent);
				margin-bottom: 4px;
			}

			.modal-title {
				margin: 0 0 12px;
				font-family: var(--font-display);
				font-weight: 400;
				font-size: clamp(1.5rem, 2.5vw, 2rem);
			}

			.modal-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 6px;
				margin-bottom: 16px;
			}

			.modal-tag {
				font-family: var(--font-mono);
				font-size: 11px;
				padding: 2px 8px;
				border: 1px solid var(--border);
				color: var(--ink-2);
			}

			.modal-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 10px;
				margin-bottom: 20px;
			}

			.modal-prose {
				font-size: 15px;
				line-height: 1.65;
				color: var(--ink-2);
			}

			.modal-prose h2,
			.modal-prose h3,
			.modal-prose h4 {
				color: var(--ink);
				margin: 1.3em 0 0.5em;
			}

			.modal-prose pre,
			.modal-prose code {
				font-family: var(--font-mono);
				font-size: 13px;
			}

			.modal-prose pre {
				padding: 14px;
				border: 1px solid var(--border);
				overflow-x: auto;
			}

			.modal-prose table {
				width: 100%;
				border-collapse: collapse;
				margin: 1em 0;
				font-size: 13.5px;
			}

			.modal-prose th,
			.modal-prose td {
				border: 1px solid var(--border);
				padding: 8px 10px;
				text-align: left;
			}

			.modal-prose .deck-viewer-container {
				border: 1px solid var(--border);
				overflow: hidden;
				margin: 1.2em 0;
				background: var(--surface);
			}

			.modal-prose .deck-main-frame {
				position: relative;
			}

			.modal-prose .deck-slide-img {
				width: 100%;
			}

			.modal-prose .deck-nav-btn {
				position: absolute;
				top: 50%;
				transform: translateY(-50%);
				background: rgba(19, 20, 22, 0.8);
				color: #fff;
				padding: 8px 12px;
			}

			.modal-prose .deck-prev {
				left: 10px;
			}

			.modal-prose .deck-next {
				right: 10px;
			}

			.modal-prose .deck-footer-bar {
				padding: 8px 12px;
				font-family: var(--font-mono);
				font-size: 12px;
				display: flex;
				justify-content: space-between;
				color: var(--ink-2);
			}

			/* =========================================================
			   RESPONSIVE
			   ========================================================= */
			@media (max-width: 960px) {
				.hero-split,
				.featured-grid,
				.contact-grid {
					grid-template-columns: 1fr;
					gap: 20px;
				}

				.featured-info-col {
					min-height: auto;
				}

				.work-grid,
				.skills-cols {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}

				.timeline-row {
					grid-template-columns: 1fr;
					gap: 6px;
				}
			}

			@media (max-width: 640px) {
				.shell {
					padding-left: 16px;
					padding-right: 16px;
				}

				.brand-role,
				.nav-links a:not(.nav-cv-btn) {
					display: none;
				}

				.work-grid,
				.skills-cols,
				.about-split {
					grid-template-columns: 1fr;
				}

				.portrait-box {
					max-width: 160px;
				}
			}
		</style>
	</body>
</html>
