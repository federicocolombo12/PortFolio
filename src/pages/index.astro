---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const allProjects = (await getCollection('projects')).sort(
	(a, b) => (a.data.rank ?? 99) - (b.data.rank ?? 99)
);

// Pre-render content for all projects for in-page modal deep dives
const renderedProjects = await Promise.all(
	allProjects.map(async (project) => {
		const { Content } = await render(project);
		return {
			...project,
			Content,
		};
	})
);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Rich media galleries for key projects
const projectMediaMap: Record<string, Array<{ type: 'video' | 'image', url: string, thumb: string, title?: string }>> = {
	'thesis-medical-xr': [
		{ type: 'video', url: `${baseUrl}/videos/pulse-engine/bouba_kiki_morph.mp4`, thumb: `${baseUrl}/videos/pulse-engine/bouba_kiki_morph_poster.jpg`, title: 'Bouba/Kiki SDF Morphing (Quest 3 90FPS)' },
		{ type: 'video', url: `${baseUrl}/videos/pulse-engine/csg_modeling_demo.mp4`, thumb: `${baseUrl}/videos/pulse-engine/csg_modeling_demo_poster.jpg`, title: 'Real-Time CSG Boolean Modeling' },
		{ type: 'video', url: `${baseUrl}/videos/pulse-engine/vfx_swarm_adhesion.mp4`, thumb: `${baseUrl}/videos/pulse-engine/vfx_swarm_adhesion_poster.jpg`, title: 'GPU Voxelizer Particle Swarm' },
		{ type: 'video', url: `${baseUrl}/videos/pulse-engine/profiling_hud_recording.mp4`, thumb: `${baseUrl}/videos/pulse-engine/profiling_hud_recording_poster.jpg`, title: 'Snapdragon XR2 Profiling HUD' },
		{ type: 'image', url: `${baseUrl}/projects/pulse-engine/daw_mixer_full.png`, thumb: `${baseUrl}/projects/pulse-engine/daw_mixer_full.png`, title: 'Virtual DAW Biometric Mixer' },
		{ type: 'image', url: `${baseUrl}/projects/pulse-engine/biosignal_sdf_material_inspector.png`, thumb: `${baseUrl}/projects/pulse-engine/biosignal_sdf_material_inspector.png`, title: 'Shader Material Inspector' },
	],
	'graphics-lab': [
		{ type: 'video', url: `${baseUrl}/videos/graphics-lab/PBR_Screen.mov`, thumb: `${baseUrl}/projects/graphics-lab/hero.png`, title: 'Cook-Torrance PBR Engine' },
		{ type: 'video', url: `${baseUrl}/videos/graphics-lab/02_Deferred.mov`, thumb: `${baseUrl}/projects/graphics-lab/hero.png`, title: 'Deferred Shading G-Buffer Pipeline' },
		{ type: 'video', url: `${baseUrl}/videos/graphics-lab/SPOM.mov`, thumb: `${baseUrl}/projects/graphics-lab/hero.png`, title: 'Silhouette Parallax Occlusion Mapping' },
		{ type: 'video', url: `${baseUrl}/videos/graphics-lab/01_RayMarcher.mov`, thumb: `${baseUrl}/projects/graphics-lab/hero.png`, title: 'SDF Raymarching Sandbox' },
	],
	'smart-cable-generator': [
		{ type: 'video', url: `${baseUrl}/projects/pipeline-tools/cable_demo_3.mov`, thumb: `${baseUrl}/projects/pipeline-tools/ui_screenshot.jpg`, title: 'Real-Time Catenary Cable Physics' },
		{ type: 'video', url: `${baseUrl}/projects/pipeline-tools/cable_demo_1.mov`, thumb: `${baseUrl}/projects/pipeline-tools/ui_screenshot.jpg`, title: 'Multi-Object Surface Snapping' },
		{ type: 'image', url: `${baseUrl}/projects/pipeline-tools/ui_screenshot.jpg`, thumb: `${baseUrl}/projects/pipeline-tools/ui_screenshot.jpg`, title: 'Blender Add-on Custom UI Panel' },
	],
	'ue5-procedural-environment': [
		{ type: 'video', url: `${baseUrl}/videos/tech-art/a1_pcg.mp4`, thumb: `${baseUrl}/covers/UE5 Tech Art Showcase.png`, title: 'Procedural Content Generation (PCG)' },
		{ type: 'video', url: `${baseUrl}/videos/tech-art/env_a1.mp4`, thumb: `${baseUrl}/covers/UE5 Tech Art Showcase.png`, title: 'Dynamic Weather & Lighting Pipeline' },
	],
	'ue5-niagara-vfx': [
		{ type: 'video', url: `${baseUrl}/videos/tech-art/a5_render.mp4`, thumb: `${baseUrl}/covers/UE5 Tech Art Showcase.png`, title: 'Niagara GPU Comet Particle System' },
		{ type: 'video', url: `${baseUrl}/videos/tech-art/a5_final.mp4`, thumb: `${baseUrl}/covers/UE5 Tech Art Showcase.png`, title: 'Final Cinematics Composite' },
	],
	'spicy-mercante': [
		{ type: 'video', url: `${baseUrl}/projects/spicy-mercante/video2.mp4`, thumb: `${baseUrl}/projects/spicy-mercante/image1.jpeg`, title: 'Multiplayer Card Game Mechanics' },
		{ type: 'image', url: `${baseUrl}/projects/spicy-mercante/image1.jpeg`, thumb: `${baseUrl}/projects/spicy-mercante/image1.jpeg`, title: 'Spicy Mercante Board View' },
	],
	'visual-effects': [
		{ type: 'video', url: `${baseUrl}/projects/visual-effects/tech_art_video.mp4`, thumb: `${baseUrl}/projects/visual-effects/set_photo1.jpg`, title: 'VFX Breakdown & Tracking' },
		{ type: 'image', url: `${baseUrl}/projects/visual-effects/set_photo1.jpg`, thumb: `${baseUrl}/projects/visual-effects/set_photo1.jpg`, title: 'On-Set Camera Tracking Markers' },
	],
	'harmony': [
		{ type: 'video', url: `${baseUrl}/projects/Game_Development/Gamedev/Harmony/harmony_live_demo.mp4`, thumb: `${baseUrl}/projects/Game_Development/Gamedev/Harmony/harmony_live_demo_poster.jpg`, title: 'Real-Time Vocal Cymatics & Meta Quest Live Interaction' },
		{ type: 'image', url: `${baseUrl}/covers/Harmony.png`, thumb: `${baseUrl}/covers/Harmony.png`, title: 'Harmony VR Key Visual' },
		{ type: 'image', url: `${baseUrl}/projects/Game_Development/Gamedev/Harmony/harmony_logo.png`, thumb: `${baseUrl}/projects/Game_Development/Gamedev/Harmony/harmony_logo.png`, title: 'Harmony VR Logo' },
	],
};

// Representative showreel slides
const showreelSlides = [
	{
		title: 'PulseEngine :: Volumetric Raymarching',
		sub: 'Unity 6 • HLSL Compute • CSG Morphing • 90 FPS Quest 3',
		tag: 'MEDICAL XR',
		image: `${baseUrl}/videos/pulse-engine/bouba_kiki_morph_poster.jpg`,
		video: `${baseUrl}/videos/pulse-engine/bouba_kiki_morph.mp4`,
		projectId: 'thesis-medical-xr'
	},
	{
		title: 'Graphics Lab :: Custom C++ Engine',
		sub: 'C++17 • OpenGL 3.3 Core • Deferred Shading • Cook-Torrance PBR',
		tag: 'ENGINE DEV',
		image: `${baseUrl}/projects/graphics-lab/hero.png`,
		video: `${baseUrl}/videos/graphics-lab/PBR_Screen.mov`,
		projectId: 'graphics-lab'
	},
	{
		title: 'Smart Cable Generator :: Blender Add-on',
		sub: 'Python 3 • Catenary Physics • Procedural Curve Authoring',
		tag: 'TOOLING',
		image: `${baseUrl}/covers/Smart Cable Generator.jpg`,
		video: `${baseUrl}/projects/pipeline-tools/cable_demo_3.mov`,
		projectId: 'smart-cable-generator'
	},
	{
		title: 'UE5 Procedural Environments',
		sub: 'Unreal Engine 5 • PCG Graph • Megascents Biomes • Nanite',
		tag: 'TECH ART',
		image: `${baseUrl}/covers/UE5 Tech Art Showcase.png`,
		video: `${baseUrl}/videos/tech-art/a1_pcg.mp4`,
		projectId: 'ue5-procedural-environment'
	},
	{
		title: 'Line Operator :: Retro CRT Shaders',
		sub: 'Unity C# • Custom HLSL Shaders • Lead Technical Producer',
		tag: 'STUDENT GAME',
		image: `${baseUrl}/covers/Line Operator.png`,
		video: '',
		projectId: 'line-operator'
	},
	{
		title: 'Harmony VR :: Singing the Light',
		sub: 'VR Interactive Experience • Spatial Audio Interaction',
		tag: 'XR GAME',
		image: `${baseUrl}/projects/Game_Development/Gamedev/Harmony/harmony_live_demo_poster.jpg`,
		video: `${baseUrl}/projects/Game_Development/Gamedev/Harmony/harmony_live_demo.mp4`,
		projectId: 'harmony'
	}
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} | Computer Graphics Engineer & Tech Artist`} description={SITE_DESCRIPTION} />
		<style>
			/* Layout Base */
			html {
				scroll-behavior: smooth;
			}
			main {
				width: 1140px;
				max-width: calc(100% - 2.5rem);
				margin: 0 auto;
				padding: 2rem 0 5rem;
			}

			/* Section Shared Header */
			.section-header {
				margin-bottom: 2.75rem;
				text-align: center;
			}
			.section-tag {
				font-family: var(--font-mono);
				font-size: 0.82rem;
				font-weight: 600;
				color: var(--accent);
				letter-spacing: 0.08em;
				text-transform: uppercase;
				display: block;
				margin-bottom: 0.4rem;
			}
			.section-title {
				font-size: 2.4rem;
				font-weight: 800;
				letter-spacing: -0.025em;
				color: #ffffff;
				margin-bottom: 0.5rem;
				text-transform: uppercase;
			}
			.section-subtitle {
				font-size: 1.08rem;
				color: #94a3b8;
				margin: 0 auto;
				max-width: 680px;
				line-height: 1.6;
			}

			/* ----------------------------------------------------
			   1. HERO SECTION & SHOWREEL SLIDESHOW
			   ---------------------------------------------------- */
			.hero {
				padding: 3rem 0 4.5rem;
				display: grid;
				grid-template-columns: 1.15fr 0.85fr;
				gap: 3.5rem;
				align-items: center;
			}
			.hero-left {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
			}
			.hero-status {
				margin-bottom: 1.25rem;
			}
			.hero-title {
				font-size: 3.6rem;
				font-weight: 800;
				letter-spacing: -0.035em;
				line-height: 1.08;
				margin-bottom: 0.65rem;
				color: #ffffff;
			}
			.hero-role {
				font-size: 1.45rem;
				font-weight: 600;
				color: #60a5fa;
				margin-bottom: 1.5rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
			.hero-role .accent-pipe {
				color: rgba(255, 255, 255, 0.25);
				font-weight: 300;
			}
			.hero-bio {
				font-size: 1.08rem;
				line-height: 1.8;
				color: #cbd5e1;
				margin-bottom: 2rem;
				max-width: 580px;
			}
			.hero-bio strong {
				color: #ffffff;
			}
			.hero-actions {
				display: flex;
				align-items: center;
				gap: 1rem;
				flex-wrap: wrap;
			}

			/* Hero Showreel Showcase Card */
			.hero-showreel-card {
				position: relative;
				border-radius: 18px;
				background: rgba(15, 20, 32, 0.85);
				border: 1px solid rgba(255, 255, 255, 0.12);
				box-shadow: 0 20px 48px rgba(0, 0, 0, 0.65), 0 0 35px rgba(59, 130, 246, 0.15);
				overflow: hidden;
				backdrop-filter: blur(16px);
			}
			.showreel-hud-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 1rem;
				background: rgba(0, 0, 0, 0.5);
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: #94a3b8;
			}
			.terminal-dots {
				display: flex;
				gap: 0.35rem;
			}
			.terminal-dot {
				width: 9px;
				height: 9px;
				border-radius: 50%;
			}
			.dot-red { background: #ef4444; }
			.dot-yellow { background: #eab308; }
			.dot-green { background: #22c55e; }

			.showreel-screen {
				position: relative;
				width: 100%;
				aspect-ratio: 16/10;
				background: #000;
				overflow: hidden;
				cursor: pointer;
			}
			.showreel-slide-media {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				opacity: 0;
				transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1);
				pointer-events: none;
			}
			.showreel-slide-media.active {
				opacity: 1;
				pointer-events: auto;
			}
			.showreel-slide-media img,
			.showreel-slide-media video {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.showreel-play-overlay {
				position: absolute;
				inset: 0;
				background: rgba(0, 0, 0, 0.25);
				display: flex;
				align-items: center;
				justify-content: center;
				opacity: 0;
				transition: opacity 0.25s ease;
			}
			.showreel-screen:hover .showreel-play-overlay {
				opacity: 1;
			}
			.showreel-inspect-badge {
				background: rgba(15, 23, 42, 0.85);
				border: 1px solid rgba(255, 255, 255, 0.2);
				backdrop-filter: blur(8px);
				color: #ffffff;
				padding: 0.5rem 1rem;
				border-radius: 9999px;
				font-size: 0.85rem;
				font-weight: 600;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.showreel-hud-footer {
				padding: 0.85rem 1rem;
				background: rgba(10, 14, 24, 0.95);
				border-top: 1px solid rgba(255, 255, 255, 0.07);
				display: flex;
				align-items: center;
				justify-content: space-between;
			}
			.showreel-meta {
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
				min-width: 0;
			}
			.showreel-meta-title {
				font-size: 0.88rem;
				font-weight: 700;
				color: #f8fafc;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.showreel-meta-sub {
				font-family: var(--font-mono);
				font-size: 0.73rem;
				color: var(--accent-light);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.showreel-indicators {
				display: flex;
				align-items: center;
				gap: 0.35rem;
			}
			.showreel-dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: rgba(255, 255, 255, 0.2);
				cursor: pointer;
				transition: all 0.25s;
			}
			.showreel-dot.active {
				background: var(--accent);
				width: 18px;
				border-radius: 4px;
			}

			/* ----------------------------------------------------
			   2. PORTFOLIO & IN-PAGE MODAL
			   ---------------------------------------------------- */
			.portfolio-section {
				padding: 4.5rem 0;
				border-top: 1px solid rgba(255, 255, 255, 0.06);
			}
			.filter-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				justify-content: center;
				margin-bottom: 2.75rem;
			}
			.filter-btn {
				background: rgba(18, 24, 38, 0.75);
				border: 1px solid rgba(255, 255, 255, 0.08);
				color: #94a3b8;
				padding: 0.5rem 1.15rem;
				border-radius: 9999px;
				cursor: pointer;
				transition: all 0.25s ease;
				font-size: 0.88rem;
				font-weight: 500;
				font-family: inherit;
			}
			.filter-btn:hover {
				background: rgba(255, 255, 255, 0.08);
				border-color: rgba(255, 255, 255, 0.22);
				color: #ffffff;
			}
			.filter-btn.active {
				background: var(--accent);
				color: #ffffff;
				border-color: var(--accent);
				font-weight: 600;
				box-shadow: 0 0 16px rgba(var(--accent-rgb), 0.35);
			}

			/* Projects Grid with 3 cards per row matching Francisco reference */
			.projects-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.75rem;
				margin-bottom: 2rem;
			}
			.project-card {
				background: var(--bg-card);
				border: 1px solid var(--border-subtle);
				border-radius: 16px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
				transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.45s ease, box-shadow 0.45s ease;
				cursor: pointer;
				text-align: left;
				padding: 0;
				position: relative;
			}
			.project-card:hover {
				transform: translateY(-5px);
				border-color: var(--border-glow);
				box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 24px rgba(var(--accent-rgb), 0.15);
			}
			.project-card.hidden-card {
				opacity: 0;
				transform: translateY(22px);
				transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.45s ease, box-shadow 0.45s ease;
			}
			.project-card.hidden-card.revealed {
				opacity: 1;
				transform: translateY(0);
			}
			.card-thumb-wrapper {
				position: relative;
				width: 100%;
				aspect-ratio: 16/9;
				overflow: hidden;
				background: #090d14;
			}
			.card-thumb-wrapper img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				box-shadow: none;
				transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.project-card:hover .card-thumb-wrapper img {
				transform: scale(1.04);
			}
			.card-overlay-badge {
				position: absolute;
				top: 0.85rem;
				left: 0.85rem;
				background: rgba(10, 14, 24, 0.85);
				border: 1px solid rgba(255, 255, 255, 0.15);
				backdrop-filter: blur(8px);
				padding: 0.25rem 0.65rem;
				border-radius: 6px;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--accent-light);
				font-weight: 600;
			}
			.card-media-indicator {
				position: absolute;
				top: 0.85rem;
				right: 0.85rem;
				background: rgba(10, 14, 24, 0.85);
				border: 1px solid rgba(255, 255, 255, 0.15);
				backdrop-filter: blur(8px);
				padding: 0.25rem 0.55rem;
				border-radius: 6px;
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: #ffffff;
				display: flex;
				align-items: center;
				gap: 0.3rem;
			}
			.card-body {
				padding: 1.35rem;
				display: flex;
				flex-direction: column;
				flex-grow: 1;
			}
			.card-title {
				font-size: 1.25rem;
				font-weight: 700;
				margin-bottom: 0.5rem;
				color: #ffffff;
				line-height: 1.3;
				transition: color 0.2s;
			}
			.project-card:hover .card-title {
				color: var(--accent-light);
			}
			.card-desc {
				font-size: 0.92rem;
				line-height: 1.6;
				color: #94a3b8;
				margin-bottom: 1rem;
				flex-grow: 1;
			}
			.card-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding-top: 0.85rem;
				border-top: 1px solid rgba(255, 255, 255, 0.05);
			}
			.card-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}
			.card-open-hint {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--accent);
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				font-weight: 600;
				flex-shrink: 0;
			}

			/* Chevron Expand Arrow Button */
			.expand-trigger-bar {
				display: flex;
				justify-content: center;
				margin-top: 1.5rem;
			}
			.expand-chevron-btn {
				background: rgba(18, 24, 38, 0.85);
				border: 1px solid rgba(255, 255, 255, 0.12);
				color: #94a3b8;
				width: 48px;
				height: 48px;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
			}
			.expand-chevron-btn:hover {
				background: var(--accent);
				color: #ffffff;
				border-color: var(--accent);
				transform: translateY(2px) scale(1.05);
				box-shadow: 0 0 20px rgba(var(--accent-rgb), 0.4);
			}
			.expand-chevron-btn svg {
				transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.expand-chevron-btn.expanded svg {
				transform: rotate(180deg);
			}

			/* ----------------------------------------------------
			   IN-PAGE MODAL (IMAGE 2 MATCH)
			   ---------------------------------------------------- */
			.modal-overlay {
				position: fixed;
				inset: 0;
				z-index: 1000;
				background: rgba(7, 10, 16, 0.88);
				backdrop-filter: blur(14px);
				-webkit-backdrop-filter: blur(14px);
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 2rem 1.5rem;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.5s ease;
			}
			.modal-overlay.open {
				opacity: 1;
				pointer-events: auto;
			}
			.modal-box {
				background: #0f1422;
				border: 1px solid rgba(255, 255, 255, 0.12);
				box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85), 0 0 45px rgba(59, 130, 246, 0.15);
				border-radius: 20px;
				width: 100%;
				max-width: 920px;
				max-height: 90vh;
				overflow-y: auto;
				position: relative;
				transform: translateY(30px) scale(0.97);
				transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
				display: flex;
				flex-direction: column;
			}
			.modal-overlay.open .modal-box {
				transform: translateY(0) scale(1);
			}
			.modal-close-btn {
				position: absolute;
				top: 1.25rem;
				right: 1.25rem;
				z-index: 30;
				background: rgba(15, 20, 32, 0.85);
				border: 1px solid rgba(255, 255, 255, 0.15);
				color: #ffffff;
				width: 38px;
				height: 38px;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: all 0.2s;
			}
			.modal-close-btn:hover {
				background: rgba(239, 68, 68, 0.85);
				border-color: #ef4444;
				transform: scale(1.08);
			}

			/* Modal Media Viewer & Carousel */
			.modal-viewer-container {
				background: #000;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				position: relative;
			}
			.modal-main-display {
				position: relative;
				width: 100%;
				aspect-ratio: 16/9;
				background: #000;
				overflow: hidden;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.modal-main-display video,
			.modal-main-display img {
				width: 100%;
				height: 100%;
				object-fit: contain;
				display: block;
			}
			.viewer-arrow-btn {
				position: absolute;
				top: 50%;
				transform: translateY(-50%);
				z-index: 20;
				background: rgba(10, 14, 24, 0.7);
				border: 1px solid rgba(255, 255, 255, 0.15);
				color: #ffffff;
				width: 44px;
				height: 44px;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: all 0.2s;
			}
			.viewer-arrow-btn:hover {
				background: var(--accent);
				color: #ffffff;
				transform: translateY(-50%) scale(1.1);
			}
			.arrow-left { left: 1rem; }
			.arrow-right { right: 1rem; }

			/* Thumbnail Strip (Image 2 match) */
			.modal-thumb-strip {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				padding: 0.75rem 1.25rem;
				background: rgba(10, 14, 22, 0.95);
				border-top: 1px solid rgba(255, 255, 255, 0.06);
				overflow-x: auto;
			}
			.modal-thumb-item {
				width: 74px;
				height: 44px;
				border-radius: 6px;
				overflow: hidden;
				border: 2px solid transparent;
				opacity: 0.6;
				cursor: pointer;
				flex-shrink: 0;
				position: relative;
				transition: all 0.2s;
			}
			.modal-thumb-item:hover {
				opacity: 0.9;
				transform: translateY(-1px);
			}
			.modal-thumb-item.active {
				opacity: 1;
				border-color: var(--accent);
				box-shadow: 0 0 10px rgba(var(--accent-rgb), 0.5);
			}
			.modal-thumb-item img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.thumb-video-icon {
				position: absolute;
				bottom: 3px;
				right: 3px;
				background: rgba(0, 0, 0, 0.75);
				border-radius: 3px;
				padding: 1px 3px;
				display: flex;
				align-items: center;
			}

			/* Modal Content & Technical Deep Dive */
			.modal-content {
				padding: 2.25rem;
			}
			.modal-meta-row {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 0.75rem;
			}
			.modal-category {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				font-weight: 600;
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.1);
				border: 1px solid rgba(var(--accent-rgb), 0.25);
				padding: 0.2rem 0.6rem;
				border-radius: 6px;
			}
			.modal-title {
				font-size: 2.1rem;
				font-weight: 800;
				color: #ffffff;
				margin-bottom: 0.5rem;
				line-height: 1.25;
			}
			.modal-subtitle {
				font-size: 1.15rem;
				font-weight: 600;
				color: #94a3b8;
				margin-bottom: 1.25rem;
			}
			.modal-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 1.75rem;
			}
			.modal-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.85rem;
				margin-bottom: 2rem;
				padding-bottom: 1.75rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
			}
			.modal-body-prose {
				font-size: 1.02rem;
				line-height: 1.8;
				color: #cbd5e1;
			}
			.modal-body-prose h2, .modal-body-prose h3, .modal-body-prose h4 {
				color: #ffffff;
				margin: 1.75rem 0 0.75rem;
			}
			.modal-body-prose video {
				max-width: 100%;
				border-radius: 12px;
				margin: 1.5rem 0;
			}
			.modal-body-prose table {
				width: 100%;
				border-collapse: collapse;
				margin: 1.5rem 0;
			}
			.modal-body-prose th, .modal-body-prose td {
				padding: 0.6rem 0.85rem;
				border: 1px solid rgba(255, 255, 255, 0.1);
			}
			.modal-body-prose th {
				background: rgba(59, 130, 246, 0.15);
				color: #ffffff;
			}

			/* ----------------------------------------------------
			   3. EXPERIENCE & EDUCATION WITH REAL LOGOS
			   ---------------------------------------------------- */
			.experience-section {
				padding: 4.5rem 0;
				border-top: 1px solid rgba(255, 255, 255, 0.06);
			}
			.tab-toggle-bar {
				display: flex;
				justify-content: center;
				margin-bottom: 2.75rem;
			}
			.tab-toggle-inner {
				display: inline-flex;
				background: rgba(15, 20, 32, 0.8);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 12px;
				padding: 0.35rem;
			}
			.tab-toggle-btn {
				background: transparent;
				border: none;
				color: #94a3b8;
				padding: 0.65rem 1.4rem;
				border-radius: 8px;
				font-size: 0.92rem;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.2s ease;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.tab-toggle-btn:hover {
				color: #ffffff;
			}
			.tab-toggle-btn.active {
				background: var(--accent);
				color: #ffffff;
				box-shadow: 0 4px 12px rgba(var(--accent-rgb), 0.3);
			}

			.timeline-list {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			.experience-card {
				background: var(--bg-card);
				border: 1px solid var(--border-subtle);
				border-radius: 16px;
				padding: 1.75rem;
				display: grid;
				grid-template-columns: 68px 1fr;
				gap: 1.5rem;
				align-items: flex-start;
				transition: border-color 0.3s, transform 0.3s;
			}
			.experience-card:hover {
				border-color: rgba(59, 130, 246, 0.35);
				transform: translateY(-2px);
			}
			.exp-logo-wrap {
				width: 64px;
				height: 64px;
				border-radius: 14px;
				background: #ffffff;
				border: 1px solid rgba(255, 255, 255, 0.15);
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 7px;
				box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
				flex-shrink: 0;
			}
			.exp-logo-wrap img {
				max-width: 100%;
				max-height: 100%;
				object-fit: contain;
				display: block;
				box-shadow: none;
				border-radius: 0;
			}

			.exp-content {
				display: flex;
				flex-direction: column;
			}
			.exp-header-row {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 0.4rem;
				flex-wrap: wrap;
			}
			.exp-title {
				font-size: 1.25rem;
				font-weight: 700;
				color: #ffffff;
				margin: 0;
			}
			.exp-date-pill {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: #93c5fd;
				background: rgba(59, 130, 246, 0.12);
				border: 1px solid rgba(59, 130, 246, 0.28);
				padding: 0.25rem 0.65rem;
				border-radius: 6px;
				font-weight: 600;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
			}
			.exp-company {
				font-size: 0.95rem;
				font-weight: 600;
				color: #94a3b8;
				margin-bottom: 0.85rem;
			}
			.exp-details {
				list-style-type: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			.exp-details li {
				position: relative;
				padding-left: 1.25rem;
				font-size: 0.94rem;
				line-height: 1.6;
				color: #cbd5e1;
			}
			.exp-details li::before {
				content: '▹';
				position: absolute;
				left: 0;
				color: var(--accent);
				font-size: 0.9rem;
			}

			/* ----------------------------------------------------
			   4. ABOUT ME SECTION (IMAGE 3 MATCH)
			   ---------------------------------------------------- */
			.about-section {
				padding: 4.5rem 0;
				border-top: 1px solid rgba(255, 255, 255, 0.06);
			}
			.about-bio-split {
				display: grid;
				grid-template-columns: 260px 1fr;
				gap: 3.5rem;
				align-items: center;
				margin-bottom: 3.5rem;
			}
			.about-avatar-col {
				display: flex;
				justify-content: center;
			}
			.about-avatar-frame {
				width: 230px;
				height: 230px;
				border-radius: 50%;
				overflow: hidden;
				border: 3px solid rgba(255, 255, 255, 0.15);
				box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 30px rgba(59, 130, 246, 0.2);
				background: #111624;
			}
			.about-avatar-frame img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				box-shadow: none;
				border-radius: 0;
			}
			.about-text-col p {
				font-size: 1.05rem;
				line-height: 1.85;
				color: #cbd5e1;
				margin-bottom: 1.25rem;
			}
			.about-text-col strong {
				color: #ffffff;
			}
			.about-cta-row {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-top: 1.5rem;
				flex-wrap: wrap;
			}

			/* Software & Skills Grids (Image 3 match) */
			.capabilities-grid-split {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 3rem;
				border-top: 1px solid rgba(255, 255, 255, 0.08);
				padding-top: 3rem;
			}
			.cap-col-title {
				font-size: 1.15rem;
				font-weight: 700;
				color: #ffffff;
				margin-bottom: 1.25rem;
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}
			.cap-items-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			.cap-item-card {
				background: var(--bg-card);
				border: 1px solid var(--border-subtle);
				border-radius: 12px;
				padding: 0.85rem 1rem;
				display: flex;
				align-items: center;
				gap: 0.75rem;
				transition: all 0.2s;
			}
			.cap-item-card:hover {
				border-color: rgba(59, 130, 246, 0.35);
				transform: translateY(-2px);
				background: var(--bg-card-hover);
			}
			.cap-item-icon {
				width: 22px;
				height: 22px;
				flex-shrink: 0;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.cap-item-text {
				font-size: 0.88rem;
				font-weight: 600;
				color: #f1f5f9;
			}

			/* ----------------------------------------------------
			   5. CONTACT & RESUME SECTION
			   ---------------------------------------------------- */
			.contact-section {
				padding: 4.5rem 0 2rem;
				border-top: 1px solid rgba(255, 255, 255, 0.06);
			}
			.contact-card {
				background: linear-gradient(135deg, rgba(18, 24, 38, 0.95), rgba(13, 17, 26, 0.95));
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 20px;
				padding: 3rem;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 3rem;
				box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
			}
			.contact-left h3 {
				font-size: 1.8rem;
				font-weight: 800;
				color: #ffffff;
				margin-bottom: 0.8rem;
			}
			.contact-left p {
				color: #94a3b8;
				font-size: 1.02rem;
				line-height: 1.7;
				margin-bottom: 1.75rem;
			}
			.contact-links-list {
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
			}
			.contact-link-item {
				display: inline-flex;
				align-items: center;
				gap: 0.65rem;
				color: #e2e8f0;
				font-size: 0.95rem;
				text-decoration: none;
				transition: color 0.2s;
			}
			.contact-link-item:hover {
				color: var(--accent);
				text-shadow: none;
			}
			.contact-link-item svg {
				color: var(--accent);
			}

			.contact-right {
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 1.25rem;
				background: rgba(0, 0, 0, 0.25);
				border: 1px solid rgba(255, 255, 255, 0.06);
				border-radius: 16px;
				padding: 2rem;
			}
			.cv-downloads-title {
				font-family: var(--font-mono);
				font-size: 0.82rem;
				color: var(--accent);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-bottom: 0.4rem;
				font-weight: 600;
			}
			.cv-buttons-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.75rem;
			}

			/* Floating Back-To-Top Button */
			.back-to-top-btn {
				position: fixed;
				bottom: 2rem;
				right: 2rem;
				z-index: 90;
				background: rgba(18, 24, 38, 0.9);
				border: 1px solid rgba(255, 255, 255, 0.15);
				color: #ffffff;
				width: 44px;
				height: 44px;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
				opacity: 0;
				transform: translateY(10px);
				pointer-events: none;
				transition: all 0.25s ease;
			}
			.back-to-top-btn.visible {
				opacity: 1;
				transform: translateY(0);
				pointer-events: auto;
			}
			.back-to-top-btn:hover {
				background: var(--accent);
				box-shadow: 0 0 20px rgba(var(--accent-rgb), 0.5);
			}

			/* Responsive */
			@media (max-width: 960px) {
				.hero {
					grid-template-columns: 1fr;
					gap: 2.5rem;
					padding: 2rem 0 3.5rem;
				}
				.hero-title {
					font-size: 2.8rem;
				}
				.projects-grid {
					grid-template-columns: repeat(2, 1fr);
				}
				.about-bio-split {
					grid-template-columns: 1fr;
					text-align: center;
					gap: 2rem;
				}
				.capabilities-grid-split {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
				.contact-card {
					grid-template-columns: 1fr;
					padding: 2rem;
				}
			}
			@media (max-width: 640px) {
				.projects-grid {
					grid-template-columns: 1fr;
				}
				.cap-items-grid {
					grid-template-columns: 1fr;
				}
				.cv-buttons-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- 1. HERO SECTION -->
			<section class="hero" id="hero">
				<div class="hero-left">
					<div class="hero-status">
						<div class="status-pill">
							<span class="pulse-dot"></span>
							<span>Open to Graphics & Tech Art Roles</span>
						</div>
					</div>
					<h1 class="hero-title">Federico Colombo</h1>
					<h2 class="hero-role">
						<span>Computer Graphics Engineer</span>
						<span class="accent-pipe">/</span>
						<span>Technical Artist</span>
					</h2>
					<p class="hero-bio">
						Specialized in <strong>real-time rendering</strong>, low-level <strong>engine architecture (C++)</strong>, and <strong>procedural pipelines</strong>. Graduated with honors (<strong>110/110 con Lode</strong>) in Cinema & Media Engineering from Politecnico di Torino, with active R&D in bio-adaptive volumetric SDF raymarching and mobile XR optimization.
					</p>
					<div class="hero-actions">
						<a href="#projects" class="btn-primary nav-scroll-btn">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
							<span>Explore Projects</span>
						</a>
						<a href="#experience" class="btn-secondary nav-scroll-btn">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
							<span>Experience</span>
						</a>
						<a href={`${baseUrl}/cv`} class="btn-secondary">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
							<span>View CV</span>
						</a>
					</div>
				</div>

				<!-- Hero Showreel Showcase Card (Slideshow) -->
				<div class="hero-right">
					<div class="hero-showreel-card" id="heroShowreelCard">
						<div class="showreel-hud-header">
							<div class="terminal-dots">
								<span class="terminal-dot dot-red"></span>
								<span class="terminal-dot dot-yellow"></span>
								<span class="terminal-dot dot-green"></span>
							</div>
							<span id="showreelHudTitle">SHOWREEL // SELECTED WORK</span>
						</div>

						<div class="showreel-screen" id="showreelScreen" title="Click to inspect this project">
							{
								showreelSlides.map((slide, idx) => (
									<div 
										class={`showreel-slide-media ${idx === 0 ? 'active' : ''}`}
										data-index={idx}
										data-project-id={slide.projectId}
										data-title={slide.title}
										data-sub={slide.sub}
									>
										{slide.video ? (
											<video 
												src={slide.video} 
												poster={slide.image} 
												autoplay 
												loop 
												muted 
												playsinline
											></video>
										) : (
											<img src={slide.image} alt={slide.title} />
										)}
									</div>
								))
							}
							<div class="showreel-play-overlay">
								<span class="showreel-inspect-badge">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
									<span>Inspect Project Details</span>
								</span>
							</div>
						</div>

						<div class="showreel-hud-footer">
							<div class="showreel-meta">
								<span class="showreel-meta-title" id="showreelTitle">{showreelSlides[0].title}</span>
								<span class="showreel-meta-sub" id="showreelSub">{showreelSlides[0].sub}</span>
							</div>
							<div class="showreel-indicators" id="showreelIndicators">
								{
									showreelSlides.map((_, idx) => (
										<span class={`showreel-dot ${idx === 0 ? 'active' : ''}`} data-index={idx}></span>
									))
								}
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 2. PORTFOLIO & IN-PAGE MODAL -->
			<section class="portfolio-section" id="projects">
				<div class="section-header">
					<span class="section-tag">// PORTFOLIO</span>
					<h2 class="section-title">Projects</h2>
					<p class="section-subtitle">
						Low-level graphics engines, custom HLSL shaders, procedural DCC pipelines, and shipped real-time games. Click any card to inspect.
					</p>
				</div>

				<!-- Category Filters -->
				<div class="filter-bar">
