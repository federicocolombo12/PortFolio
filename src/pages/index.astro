---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getProjectBadge, getProjectMediaMap, getShowreelSlides } from '../data/projects-media';

const allProjects = (await getCollection('projects')).sort(
	(a, b) => (a.data.rank ?? 99) - (b.data.rank ?? 99)
);

// Pre-render content for all projects for in-page modal deep dives
const renderedProjects = await Promise.all(
	allProjects.map(async (project) => {
		const { Content } = await render(project);
		return {
			...project,
			Content,
		};
	})
);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const projectMediaMap = getProjectMediaMap(baseUrl);
const showreelSlides = getShowreelSlides(baseUrl);
const firstSlide = showreelSlides[0];
---

<!doctype html>
<html lang="en" class="editorial-dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
		<link rel="icon" href={`${baseUrl}/favicon.ico`} />
		<link rel="sitemap" href={`${baseUrl}/sitemap-index.xml`} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={SITE_TITLE}
			href={new URL('rss.xml', Astro.site)}
		/>
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />

		<title>{SITE_TITLE}</title>
		<meta name="description" content={SITE_DESCRIPTION} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={SITE_TITLE} />
		<meta property="og:description" content={SITE_DESCRIPTION} />
		<meta property="og:image" content={new URL(FallbackImage.src, Astro.url)} />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="site-header">
			<div class="shell header-inner">
				<div class="brand-cluster">
					<a href="#top" class="brand-name">Federico Colombo</a>
					<span class="brand-role">GRAPHICS ENGINEER · TURIN</span>
				</div>

				<nav class="nav-links" aria-label="Primary navigation">
					<a href="#projects">Work</a>
					<a href="#experience">Experience</a>
					<a href="#about">About</a>
					<a href={`${baseUrl}/cv`}>CV</a>
					<a href={`${baseUrl}/Federico Colombo - Resume.pdf`} download class="nav-cv-btn">
						CV.PDF
					</a>
				</nav>
			</div>
		</header>

		<main id="top" class="shell">
			<!-- 1. COMPACT ASYMMETRIC HERO -->
			<section class="hero-band">
				<p class="hero-eyebrow">GRAPHICS ENGINEERING · TECHNICAL ART · STANDALONE XR</p>

				<div class="hero-split">
					<h1 class="hero-headline">
						Rendering, <em>Shaders</em><br />
						&amp; Tech Art Systems.
					</h1>

					<div class="hero-bio-col">
						<p class="hero-lead">
							Low-level C++/OpenGL renderers, WebGPU compute shaders, procedural DCC pipelines, and standalone Quest 3 XR optimization. M.Sc. Cinema &amp; Media Engineering, Politecnico di Torino.
						</p>
						<div class="hero-inline-links">
							<a href="#projects" class="hero-link-accent">Explore Selected Work</a>
							<a href="https://github.com/federicocolombo12" target="_blank" rel="noopener noreferrer">
								GitHub
							</a>
							<a href="https://www.linkedin.com/in/federico-colombo10" target="_blank" rel="noopener noreferrer">
								LinkedIn
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- 2. FEATURED SHOWCASE (LOCKED 16:9 GEOMETRY ACROSS ALL SLIDES) -->
			<section class="featured-band" id="featured">
				<div class="featured-grid">
					<div class="featured-media-frame" id="showreelViewport" title="Click to inspect full breakdown">
						<video
							id="featuredVideo"
							src={firstSlide.video}
							poster={firstSlide.image}
							autoplay
							muted
							loop
							playsinline
							preload="auto"
						></video>
						<img id="featuredImage" src={firstSlide.image} alt={firstSlide.title} style="display: none;" />
						<div class="featured-telemetry" id="reelMetricBadge">
							{firstSlide.metric || firstSlide.tag}
						</div>
					</div>

					<div class="featured-info-col">
						<div>
							<div class="featured-kicker-row">
								<span class="featured-kicker" id="reelKicker">01 / FEATURED THESIS R&amp;D · 2026</span>
								<div class="reel-stepper" aria-label="Switch featured showcase">
									<button type="button" id="reelPrevBtn" aria-label="Previous showcase">&lsaquo;</button>
									<span id="reelCounter">01/{String(showreelSlides.length).padStart(2, '0')}</span>
									<button type="button" id="reelNextBtn" aria-label="Next showcase">&rsaquo;</button>
								</div>
							</div>

							<h2 class="featured-title" id="reelTitle">{firstSlide.title}</h2>
							<p class="featured-summary" id="reelSummary">
								Real-time HLSL volumetric raymarching driven by BLE physiological telemetry. Engineered for Meta Quest 3 with Dynamic Bounding Volumes, adaptive step marching, and zero-allocation C# buffers.
							</p>
						</div>

						<div class="featured-footer-bar">
							<span class="featured-stack" id="reelSub">{firstSlide.sub}</span>
							<button type="button" class="featured-cta-link" id="inspectActiveReelBtn">
								Read breakdown &rarr;
							</button>
						</div>
					</div>
				</div>
			</section>

			<!-- 3. SELECTED WORKS GRID -->
			<section class="work-band" id="projects">
				<div class="work-header-row">
					<h2 class="work-section-title">Selected Works</h2>
					<div class="filter-tabs" role="tablist" aria-label="Filter projects by discipline">
						<button type="button" class="filter-btn active" data-category="all">
							All [{String(allProjects.length).padStart(2, '0')}]
						</button>
						<button type="button" class="filter-btn" data-category="Tech Art">Graphics &amp; Engine</button>
						<button type="button" class="filter-btn" data-category="Game Development">Game Dev</button>
						<button type="button" class="filter-btn" data-category="3D Animation">3D Art</button>
						<button type="button" class="filter-btn" data-category="Filmmaking">3D &amp; VFX</button>
						<button type="button" class="filter-btn" data-category="UX / Mobile Dev">UX / Mobile</button>
					</div>
				</div>

				<div class="work-grid" id="projectsGrid">
					{allProjects.map((post, idx) => {
						const imgSrc = post.data.heroImage ? post.data.heroImage.src : '';
						const isInitiallyVisible = idx < 6;
						const badgeText = getProjectBadge(post);
						const indexNum = String(idx + 1).padStart(2, '0');
						const stackLine = (post.data.tags || []).slice(0, 3).join(' · ') || badgeText;

						return (
							<article
								class={`work-card ${!isInitiallyVisible ? 'hidden-card' : ''}`}
								data-id={post.id}
								data-index={idx}
								data-category={post.data.category || 'Tech Art'}
								data-badge={badgeText}
								data-title={post.data.title}
								data-desc={post.data.description}
								data-image={imgSrc}
								data-tags={(post.data.tags || []).join(',')}
								data-github={post.data.githubLink || ''}
								data-demo={post.data.demoLink || ''}
								data-itch={post.data.itchLink || ''}
								data-raicinema={post.data.raiCinemaLink || ''}
								data-youtube={post.data.youtubeLink || ''}
								style={!isInitiallyVisible ? 'display: none;' : ''}
							>
								<div class="card-thumb">
									{post.data.heroImage && (
										<Image
											width={720}
											height={405}
											src={post.data.heroImage}
											alt={post.data.title}
											loading={isInitiallyVisible ? 'eager' : 'lazy'}
										/>
									)}
									<span class="card-idx">{indexNum}</span>
									{post.data.githubLink && (
										<a
											href={post.data.githubLink}
											target="_blank"
											rel="noopener noreferrer"
											class="card-gh-corner"
											title="Inspect Source on GitHub"
											aria-label={`GitHub repository for ${post.data.title}`}
										>
											<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
												<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
											</svg>
										</a>
									)}
								</div>

								<div class="card-body">
									<span class="card-cat">{badgeText.toUpperCase()}</span>
									<h3 class="card-title">{post.data.title}</h3>
									<p class="card-desc">{post.data.description}</p>
									<div class="card-foot">
										<span>{stackLine}</span>
										{post.data.demoLink && (
											<a
												href={post.data.demoLink}
												target="_blank"
												rel="noopener noreferrer"
												class="card-demo-pill"
											>
												Demo &rarr;
											</a>
										)}
									</div>
								</div>
							</article>
						);
					})}
				</div>

				<div class="expand-row">
					<button type="button" class="expand-btn" id="expandGridBtn">
						Show all {allProjects.length} projects ({allProjects.length - 6} archived)
					</button>
				</div>
			</section>

			<!-- 4. EXPERIENCE & EDUCATION -->
			<section class="experience-band" id="experience">
				<div class="band-top-bar">
					<span class="band-mono-label">03 // BACKGROUND</span>
					<div class="tab-switch-inline" role="tablist">
						<button type="button" class="tab-btn active" id="tabExpBtn">Experience (4)</button>
						<button type="button" class="tab-btn" id="tabEduBtn">Education (2)</button>
					</div>
				</div>

				<div class="timeline-rows" id="expList">
					<div class="timeline-row">
						<div class="tl-left">
							<span class="tl-date">03/2026 – Present</span>
							<span class="tl-org">Lemons in the Room · Firenze / Remote</span>
						</div>
						<div class="tl-right">
							<h3 class="tl-role">Technical Artist &amp; Producer (XR Master Thesis R&amp;D)</h3>
							<ul class="tl-bullets">
								<li>Architected <em>PulseEngine</em>: a real-time bio-adaptive volumetric raymarching framework in HLSL for Meta Quest 3 driven by Bluetooth physiological sensors.</li>
								<li>Engineered Dynamic Bounding Volumes, adaptive ray-marching step sizes, and zero-allocation C# marshaling to sustain 90 FPS at 2.91ms GPU time.</li>
							</ul>
						</div>
					</div>

					<div class="timeline-row">
						<div class="tl-left">
							<span class="tl-date">11/2024 – 07/2026</span>
							<span class="tl-org">Level Up Lab · Politecnico di Torino</span>
						</div>
						<div class="tl-right">
							<h3 class="tl-role">Technical Artist, Gameplay Programmer &amp; Project Manager</h3>
							<ul class="tl-bullets">
								<li>Built custom HLSL shaders (procedural water vertex displacement, dynamic cutaway systems), Blender 3D asset pipelines, and core C# gameplay for <em>Spicy Mercante</em> and <em>Line Operator</em>.</li>
								<li>Modeled 3D assets across full pipelines, executed 3D-to-2D C# architecture refactors, and coordinated 6–7 student developers with Git LFS workflows.</li>
							</ul>
						</div>
					</div>

					<div class="timeline-row">
						<div class="tl-left">
							<span class="tl-date">10/2024 – 01/2025</span>
							<span class="tl-org">Politecnico di Torino · Torino</span>
						</div>
						<div class="tl-right">
							<h3 class="tl-role">Teaching Assistant (GUI &amp; Interaction)</h3>
							<ul class="tl-bullets">
								<li>Tutored undergraduate students during weekly lab sessions in UI/UX architecture and frontend programming fundamentals.</li>
							</ul>
						</div>
					</div>

					<div class="timeline-row">
						<div class="tl-left">
							<span class="tl-date">09/2023 – 06/2024</span>
							<span class="tl-org">RKH SRL · Torino</span>
						</div>
						<div class="tl-right">
							<h3 class="tl-role">Video Artist &amp; Color/Post-Production</h3>
							<ul class="tl-bullets">
								<li>Operated cinema cameras (RED, Blackmagic 4K/6K, Panasonic S1) and managed DaVinci Resolve grading &amp; editing pipelines.</li>
							</ul>
						</div>
					</div>
				</div>

				<div class="timeline-rows" id="eduList" style="display: none;">
					<div class="timeline-row">
						<div class="tl-left">
							<span class="tl-date">2024 – Dec 2026</span>
							<span class="tl-org">Politecnico di Torino · Expected 110/110L</span>
						</div>
						<div class="tl-right">
							<h3 class="tl-role">M.Sc. in Cinema &amp; Media Engineering</h3>
							<ul class="tl-bullets">
								<li>Focus: Real-Time Computer Graphics, Shader Programming (HLSL/GLSL/WGSL), Computer Vision, Digital Signal Processing, Engine Architecture.</li>
								<li>Thesis: <em>PulseEngine — Real-Time Bio-Adaptive Signal Routing and Volumetric SDF Raymarching in Standalone XR</em>.</li>
							</ul>
						</div>
					</div>

					<div class="timeline-row">
						<div class="tl-left">
							<span class="tl-date">2021 – 2024</span>
							<span class="tl-org">Politecnico di Torino · 100/110</span>
						</div>
						<div class="tl-right">
							<h3 class="tl-role">B.Sc. in Cinema &amp; Media Engineering</h3>
							<ul class="tl-bullets">
								<li>Engineering Core: Linear Algebra, Multivariate Calculus, Physics, Object-Oriented Programming (C/C++), Algorithms &amp; Data Structures.</li>
							</ul>
						</div>
					</div>
				</div>
			</section>

			<!-- 5. ABOUT & CAPABILITIES -->
			<section class="about-band" id="about">
				<div class="band-top-bar">
					<span class="band-mono-label">04 // CAPABILITIES &amp; PROFILE</span>
				</div>

				<div class="about-split">
					<div class="portrait-box">
						<img src={`${baseUrl}/profile.jpeg`} alt="Federico Colombo" />
					</div>
					<div class="bio-copy">
						<h2 class="work-section-title">Engineering between shader math and art direction.</h2>
						<p>
							My work sits where low-level graphics programming meets production artist workflows: writing multi-pass compute graphs and Deferred C++ renderers, optimizing volumetric raymarchers for mobile Quest 3 silicon, and shipping procedural Python add-ons that keep 3D teams fast.
						</p>
						<p>
							Alongside university research, I shipped multiple student games at Level Up Lab, taught GUI engineering labs as a Teaching Assistant, and handled on-set cinematography and post-production at RKH SRL.
						</p>
					</div>
				</div>

				<div class="skills-cols" aria-label="Technical stack matrix">
					<div class="skill-col">
						<h3 class="skill-col-title">Graphics APIs &amp; Shading</h3>
						<ul>
							<li>C++17 / 20 &amp; OpenGL 3.3 / 4.6</li>
							<li>HLSL / GLSL / WGSL Compute</li>
							<li>WebGPU (JFA SDF, Radiance, Bloom)</li>
							<li>Deferred MRT &amp; Cook-Torrance PBR</li>
							<li>Volumetric SDF Raymarching</li>
						</ul>
					</div>
					<div class="skill-col">
						<h3 class="skill-col-title">Engines &amp; DCC</h3>
						<ul>
							<li>Unity 6 (URP, C#, Job System)</li>
							<li>Unreal Engine 5 (PCG, Niagara, MetaHuman)</li>
							<li>Blender 5.3 &amp; Python API (`bpy`)</li>
							<li>Geometry Nodes &amp; OpenUSD</li>
							<li>DaVinci Resolve &amp; RealityCapture</li>
						</ul>
					</div>
					<div class="skill-col">
						<h3 class="skill-col-title">Profiling &amp; Tooling</h3>
						<ul>
							<li>RenderDoc Frame Capture Analysis</li>
							<li>NVIDIA Nsight &amp; Snapdragon Profiler</li>
							<li>Python 3 Pipeline Automation</li>
							<li>Zero-Allocation C# / GC Hygiene</li>
							<li>Git &amp; Git LFS Team Workflows</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- 6. CONTACT & CV FOOTER -->
			<section class="contact-band" id="contact">
				<div class="band-top-bar">
					<span class="band-mono-label">05 // CONTACT &amp; DOCUMENTS</span>
				</div>

				<div class="contact-grid">
					<div>
						<h2 class="work-section-title">Open to full-time Graphics Engineering &amp; Technical Art roles.</h2>
						<p class="contact-note">
							Turin, Italy · EU Citizen (immediate right to work across Europe) · Open to relocation or remote collaborations.
						</p>
						<div class="contact-links">
							<a href="mailto:colombofederico28@gmail.com">colombofederico28@gmail.com</a>
							<a href="https://github.com/federicocolombo12" target="_blank" rel="noopener noreferrer">github.com/federicocolombo12</a>
							<a href="https://www.linkedin.com/in/federico-colombo10" target="_blank" rel="noopener noreferrer">linkedin.com/in/federico-colombo10</a>
						</div>
					</div>

					<div class="cv-card">
						<span class="band-mono-label">CV DOWNLOADS (2026)</span>
						<div class="cv-btn-stack">
							<a href={`${baseUrl}/Federico Colombo - Resume.pdf`} download class="btn-solid-full">
								Resume (EN · PDF)
							</a>
							<a href={`${baseUrl}/Federico Colombo - Curriculum Vitae.pdf`} download class="btn-outline-full">
								Curriculum Vitae (IT · PDF)
							</a>
							<a href={`${baseUrl}/cv`} class="btn-outline-full">
								Interactive Web CV &rarr;
							</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="shell footer-inner">
				<span>Federico Colombo · Turin, Italy</span>
				<span>Graphics Engineering &amp; Technical Art Portfolio</span>
			</div>
		</footer>

		<!-- Floating Back To Top Button -->
		<button type="button" class="back-to-top-btn" id="backToTopBtn" aria-label="Back to top">&uarr;</button>

		<!-- IN-PAGE PROJECT MODAL -->
		<div class="modal-overlay" id="projectModal" role="dialog" aria-modal="true" aria-hidden="true">
			<div class="modal-box">
				<button type="button" class="modal-close-btn" id="modalCloseBtn" aria-label="Close dialog">&times;</button>

				<div class="modal-viewer">
					<div class="modal-stage">
						<button type="button" class="stage-arrow arrow-left" id="modalArrowLeft" aria-label="Previous media">&lsaquo;</button>
						<button type="button" class="stage-arrow arrow-right" id="modalArrowRight" aria-label="Next media">&rsaquo;</button>
						<video id="modalVideo" controls loop playsinline muted style="display: none;"></video>
						<img id="modalImage" alt="Project media preview" style="display: none;" />
					</div>
					<div class="modal-thumbs" id="modalThumbStrip"></div>
				</div>

				<div class="modal-content">
					<div class="modal-kicker" id="modalCategory"></div>
					<h2 class="modal-title" id="modalTitle"></h2>
					<div class="modal-tags" id="modalTags"></div>
					<div class="modal-actions" id="modalActions"></div>
					<div class="modal-prose" id="modalArticleBody"></div>
				</div>
			</div>
		</div>

		<!-- Pre-rendered MDX deep-dives -->
		<div style="display: none;" aria-hidden="true">
			{renderedProjects.map((p) => (
				<div id={`article-content-${p.id}`} class="stored-project-article">
					<p.Content />
				</div>
			))}
		</div>

		<script id="projectMediaData" type="application/json" set:html={JSON.stringify(projectMediaMap)}></script>
		<script id="showreelData" type="application/json" set:html={JSON.stringify(showreelSlides)}></script>

		<script>
			import { initDeckViewer } from '../scripts/deck-viewer';
			initDeckViewer();

			const mediaDataEl = document.getElementById('projectMediaData');
			const projectMediaMap = mediaDataEl ? JSON.parse(mediaDataEl.textContent || '{}') : {};
			const reelDataEl = document.getElementById('showreelData');
			const showreelSlides = reelDataEl ? JSON.parse(reelDataEl.textContent || '[]') : [];

			// Smooth anchor scroll
			document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
				anchor.addEventListener('click', (e) => {
					const href = anchor.getAttribute('href') || '';
					const target = document.getElementById(href.slice(1));
					if (!target) return;
					e.preventDefault();
					const top = target.getBoundingClientRect().top + window.scrollY - 62;
					window.scrollTo({ top, behavior: 'smooth' });
				});
			});

			// Back to top visibility
			const backToTopBtn = document.getElementById('backToTopBtn');
			window.addEventListener(
				'scroll',
				() => {
					backToTopBtn?.classList.toggle('visible', window.scrollY > 500);
				},
				{ passive: true }
			);
			backToTopBtn?.addEventListener('click', () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			});

			// 1. Featured Viewport (locked 16:9 aspect-ratio box, zero layout shift)
			const featuredVideo = document.getElementById('featuredVideo') as HTMLVideoElement | null;
			const featuredImage = document.getElementById('featuredImage') as HTMLImageElement | null;
			const reelKicker = document.getElementById('reelKicker');
			const reelTitle = document.getElementById('reelTitle');
			const reelSub = document.getElementById('reelSub');
			const reelSummary = document.getElementById('reelSummary');
			const reelMetricBadge = document.getElementById('reelMetricBadge');
			const reelCounter = document.getElementById('reelCounter');
			const reelPrevBtn = document.getElementById('reelPrevBtn');
			const reelNextBtn = document.getElementById('reelNextBtn');
			const inspectActiveReelBtn = document.getElementById('inspectActiveReelBtn');
			const showreelViewport = document.getElementById('showreelViewport');
			let activeReelIdx = 0;

			function ensureHeroVideoPlays() {
				if (featuredVideo && featuredVideo.style.display !== 'none') {
					featuredVideo.muted = true;
					const p = featuredVideo.play();
					if (p && typeof p.catch === 'function') p.catch(() => {});
				}
			}

			ensureHeroVideoPlays();
			featuredVideo?.addEventListener('canplay', ensureHeroVideoPlays, { once: true });

			function setReelSlide(idx: number) {
				if (!showreelSlides.length) return;
				activeReelIdx = (idx + showreelSlides.length) % showreelSlides.length;
				const slide = showreelSlides[activeReelIdx];
				const numStr = String(activeReelIdx + 1).padStart(2, '0');
				const totalStr = String(showreelSlides.length).padStart(2, '0');

				if (reelKicker) reelKicker.textContent = `${numStr} / FEATURED ${slide.tag} · 2026`;
				if (reelCounter) reelCounter.textContent = `${numStr}/${totalStr}`;
				if (reelTitle) reelTitle.textContent = slide.title;
				if (reelSub) reelSub.textContent = slide.sub;
				if (reelMetricBadge) reelMetricBadge.textContent = slide.metric || slide.tag;

				const matchingCard = document.querySelector(
					`.work-card[data-id="${slide.projectId}"]`
				) as HTMLElement | null;
				if (reelSummary && matchingCard) {
					reelSummary.textContent = matchingCard.getAttribute('data-desc') || '';
				}

				if (slide.video && featuredVideo && featuredImage) {
					featuredImage.style.display = 'none';
					featuredVideo.style.display = 'block';
					featuredVideo.poster = slide.image || '';
					featuredVideo.src = slide.video;
					featuredVideo.load();
					ensureHeroVideoPlays();
				} else if (featuredImage && featuredVideo) {
					featuredVideo.pause();
					featuredVideo.style.display = 'none';
					featuredImage.src = slide.image || '';
					featuredImage.style.display = 'block';
				}
			}

			reelPrevBtn?.addEventListener('click', (e) => {
				e.stopPropagation();
				setReelSlide(activeReelIdx - 1);
			});
			reelNextBtn?.addEventListener('click', (e) => {
				e.stopPropagation();
				setReelSlide(activeReelIdx + 1);
			});

			function openActiveReelModal() {
				const slide = showreelSlides[activeReelIdx];
				if (!slide) return;
				const card = document.querySelector(
					`.work-card[data-id="${slide.projectId}"]`
				) as HTMLElement | null;
				if (card) openModal(card);
			}

			inspectActiveReelBtn?.addEventListener('click', openActiveReelModal);
			showreelViewport?.addEventListener('click', openActiveReelModal);

			// 2. Work Grid Filter & Expand
			const filterButtons = document.querySelectorAll('.filter-btn');
			const workCards = document.querySelectorAll('.work-card');
			const expandBtn = document.getElementById('expandGridBtn');
			let isExpanded = false;
			let activeCat = 'all';

			function applyWorkFilter() {
				let shownInAll = 0;
				workCards.forEach((c) => {
					const el = c as HTMLElement;
					const cardCat = el.getAttribute('data-category') || '';
					const matches = activeCat === 'all' || cardCat === activeCat;

					if (!matches) {
						el.style.display = 'none';
						return;
					}

					if (activeCat === 'all') {
						el.style.display = isExpanded || shownInAll < 6 ? 'flex' : 'none';
						shownInAll++;
					} else {
						el.style.display = 'flex';
					}
				});

				if (expandBtn) {
					expandBtn.style.display = activeCat === 'all' ? 'inline-flex' : 'none';
					expandBtn.textContent = isExpanded
						? 'Collapse archive (top 6)'
						: `Show all ${workCards.length} projects (${workCards.length - 6} archived)`;
				}
			}

			filterButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					filterButtons.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');
					activeCat = btn.getAttribute('data-category') || 'all';
					applyWorkFilter();
				});
			});

			expandBtn?.addEventListener('click', () => {
				isExpanded = !isExpanded;
				applyWorkFilter();
			});

			document.querySelectorAll('.card-gh-corner, .card-demo-pill').forEach((link) => {
				link.addEventListener('click', (e) => e.stopPropagation());
			});

			// 3. Experience / Education Tabs
			const tabExpBtn = document.getElementById('tabExpBtn');
			const tabEduBtn = document.getElementById('tabEduBtn');
			const expList = document.getElementById('expList');
			const eduList = document.getElementById('eduList');

			tabExpBtn?.addEventListener('click', () => {
				tabExpBtn.classList.add('active');
				tabEduBtn?.classList.remove('active');
				if (expList) expList.style.display = 'flex';
				if (eduList) eduList.style.display = 'none';
			});

			tabEduBtn?.addEventListener('click', () => {
				tabEduBtn.classList.add('active');
				tabExpBtn?.classList.remove('active');
				if (eduList) eduList.style.display = 'flex';
				if (expList) expList.style.display = 'none';
			});

			// 4. Project Deep-Dive Modal
			const modal = document.getElementById('projectModal');
			const modalCloseBtn = document.getElementById('modalCloseBtn');
			const modalVideo = document.getElementById('modalVideo') as HTMLVideoElement | null;
			const modalImage = document.getElementById('modalImage') as HTMLImageElement | null;
			const modalArrowLeft = document.getElementById('modalArrowLeft');
			const modalArrowRight = document.getElementById('modalArrowRight');
			const modalThumbStrip = document.getElementById('modalThumbStrip');
			const modalCategory = document.getElementById('modalCategory');
			const modalTitle = document.getElementById('modalTitle');
			const modalTags = document.getElementById('modalTags');
			const modalActions = document.getElementById('modalActions');
			const modalArticleBody = document.getElementById('modalArticleBody');

			let currentMediaItems: Array<{ type: 'video' | 'image'; url: string; thumb: string; title?: string }> = [];
			let activeMediaIdx = 0;

			function renderMediaItem(index: number) {
				if (!currentMediaItems.length) return;
				activeMediaIdx = (index + currentMediaItems.length) % currentMediaItems.length;
				const item = currentMediaItems[activeMediaIdx];

				document.querySelectorAll('.modal-thumb-item').forEach((th, i) => {
					const active = i === activeMediaIdx;
					th.classList.toggle('active', active);
					if (active) th.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
				});

				if (item.type === 'video') {
					if (modalImage) modalImage.style.display = 'none';
					if (modalVideo) {
						modalVideo.poster = item.thumb || '';
						modalVideo.muted = true;
						if (modalVideo.src !== item.url) modalVideo.src = item.url;
						modalVideo.style.display = 'block';
						modalVideo.play().catch(() => {});
					}
				} else {
					if (modalVideo) {
						modalVideo.pause();
						modalVideo.style.display = 'none';
					}
					if (modalImage) {
						modalImage.src = item.url;
						modalImage.style.display = 'block';
					}
				}
			}

			function closeModal() {
				if (!modal) return;
				modal.classList.remove('open');
				modal.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
				if (modalVideo) {
					modalVideo.pause();
					modalVideo.src = '';
					modalVideo.style.display = 'none';
				}
				if (modalImage) {
					modalImage.src = '';
					modalImage.style.display = 'none';
				}
			}

			function openModal(card: HTMLElement) {
				if (!modal) return;
				const id = card.getAttribute('data-id') || '';
				const title = card.getAttribute('data-title') || '';
				const defaultImg = card.getAttribute('data-image') || '';
				const badge = card.getAttribute('data-badge') || card.getAttribute('data-category') || '';
				const tags = (card.getAttribute('data-tags') || '').split(',').filter(Boolean);
				const github = card.getAttribute('data-github') || '';
				const demo = card.getAttribute('data-demo') || '';
				const itch = card.getAttribute('data-itch') || '';
				const raicinema = card.getAttribute('data-raicinema') || '';
				const youtube = card.getAttribute('data-youtube') || '';

				if (modalCategory) modalCategory.textContent = badge;
				if (modalTitle) modalTitle.textContent = title;

				const explicitMedia = projectMediaMap[id] || [];
				if (explicitMedia.length > 0) {
					currentMediaItems = explicitMedia;
				} else if (defaultImg) {
					currentMediaItems = [{ type: 'image', url: defaultImg, thumb: defaultImg }];
				} else {
					currentMediaItems = [];
				}

				if (modalThumbStrip) {
					modalThumbStrip.innerHTML = '';
					const hasMulti = currentMediaItems.length > 1;
					modalThumbStrip.style.display = hasMulti ? 'flex' : 'none';
					if (modalArrowLeft) modalArrowLeft.style.display = hasMulti ? 'flex' : 'none';
					if (modalArrowRight) modalArrowRight.style.display = hasMulti ? 'flex' : 'none';

					if (hasMulti) {
						currentMediaItems.forEach((media, i) => {
							const btn = document.createElement('button');
							btn.type = 'button';
							btn.className = `modal-thumb-item ${i === 0 ? 'active' : ''}`;
							btn.innerHTML = `<img src="${media.thumb}" alt="Media ${i + 1}" />`;
							btn.addEventListener('click', () => renderMediaItem(i));
							modalThumbStrip.appendChild(btn);
						});
					}
				}

				if (modalTags) {
					modalTags.innerHTML = '';
					tags.forEach((tag) => {
						const span = document.createElement('span');
						span.className = 'modal-tag';
						span.textContent = tag.trim();
						modalTags.appendChild(span);
					});
				}

				if (modalActions) {
					modalActions.innerHTML = '';
					const appendLink = (href: string, label: string, solid = false) => {
						const a = document.createElement('a');
						a.href = href;
						a.target = '_blank';
						a.rel = 'noopener noreferrer';
						a.className = solid ? 'btn-solid-inline' : 'btn-outline-inline';
						a.textContent = label;
						modalActions.appendChild(a);
					};
					if (demo) appendLink(demo, 'Launch Live Demo', true);
					if (github) appendLink(github, 'GitHub Source');
					if (itch) appendLink(itch, 'Play on Itch.io');
					if (raicinema) appendLink(raicinema, 'Rai Cinema Channel');
					if (youtube) appendLink(youtube, 'Watch Video');
				}

				if (modalArticleBody) {
					const stored = document.getElementById(`article-content-${id}`);
					modalArticleBody.innerHTML = stored
						? stored.innerHTML
						: `<p>${card.getAttribute('data-desc') || ''}</p>`;
				}

				modal.classList.add('open');
				modal.setAttribute('aria-hidden', 'false');
				document.body.style.overflow = 'hidden';
				requestAnimationFrame(() => renderMediaItem(0));
			}

			workCards.forEach((c) => {
				c.addEventListener('click', () => openModal(c as HTMLElement));
			});
			modalCloseBtn?.addEventListener('click', closeModal);
			modal?.addEventListener('click', (e) => {
				if (e.target === modal) closeModal();
			});
			modalArrowLeft?.addEventListener('click', (e) => {
				e.stopPropagation();
				renderMediaItem(activeMediaIdx - 1);
			});
			modalArrowRight?.addEventListener('click', (e) => {
				e.stopPropagation();
				renderMediaItem(activeMediaIdx + 1);
			});
			document.addEventListener('keydown', (e) => {
				if (!modal?.classList.contains('open')) return;
				if (e.key === 'Escape') closeModal();
				if (e.key === 'ArrowLeft') renderMediaItem(activeMediaIdx - 1);
				if (e.key === 'ArrowRight') renderMediaItem(activeMediaIdx + 1);
			});
		</script>

